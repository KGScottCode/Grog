
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Grog.App.ViewModels"
             xmlns:ctl="using:Grog.App.Controls"
             x:Class="Grog.App.Views.Pages.OverviewPage"
             x:DataType="vm:MainWindowViewModel">
  <Grid Background="Transparent" DataContext="{Binding Overview}" x:DataType="vm:OverviewViewModel">
  <Grid.ColumnDefinitions>

    <ColumnDefinition Width="*" MinWidth="560"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="0.62*" MinWidth="320"/>
  </Grid.ColumnDefinitions>

  <ScrollViewer Grid.Column="0" Background="Transparent" VerticalScrollBarVisibility="Auto">
  <Grid RowDefinitions="Auto,Auto,*" Margin="14,69,10,10">

    <Border x:Name="GuideHealthCard" Grid.Row="0" Classes="scard" Margin="0,0,0,14" VerticalAlignment="Top">
      <Grid RowDefinitions="Auto,Auto">
        <Border Grid.Row="0" Classes="shead">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Classes="sgh" Text="LOCAL LIBRARY HEALTH"/>
            <Border Grid.Column="1" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>
          </Grid>
        </Border>
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

          <Border Grid.Row="1" Classes="section top" Padding="20,12,20,10">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

              <Grid x:Name="GuideVerdict" Grid.Column="0" ColumnDefinitions="*" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0" Classes="ledenum" Text="{Binding LedeValue}" Foreground="{Binding LedeBrush}" FontSize="30"
                             FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="2">
                      <TextBlock Classes="ledehead" Text="{Binding LedeHeadline}" FontSize="{StaticResource FontRow}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>

                      <TextBlock Text="{Binding LedeQueuedNote}" Foreground="{StaticResource InkDim}"
                                 FontSize="{StaticResource FontCaption}" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                 IsVisible="{Binding LedeQueuedNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      <Button Classes="ledebtn" Padding="0" Background="Transparent" BorderThickness="0"
                              Command="{Binding OpenIssuesCommand}" ToolTip.Tip="{Binding HealthDetailTip}"
                              VerticalAlignment="Center">
                        <TextBlock Classes="ledelink" Text="(Details)" Foreground="{StaticResource InkPrimary}"
                                   FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                      </Button>

                      <Button Classes="ledebtn" Padding="0" Background="Transparent" BorderThickness="0"
                              Command="{Binding DismissRunFailureCommand}" IsVisible="{Binding HasRunFailure}"
                              ToolTip.Tip="Forget this failure notice. The files stay queued for the next run." VerticalAlignment="Center">
                        <TextBlock Classes="ledelink" Text="(Dismiss)" Foreground="{StaticResource InkDim}"
                                   FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                      </Button>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding HasHealthStatus}">
                      <TextBlock Text="{Binding HealthStatusText}" Foreground="{Binding HealthStatusBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>

                      <Button Classes="primary" Content="Fix It" Padding="10,2" Margin="4,0,0,0" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Left"
                              Command="{Binding LedeFixNowCommand}" IsVisible="{Binding ShowLedeFixNow}"
                              ToolTip.Tip="Re-queue the affected files at the top of the download queue. If downloads are paused they stay paused until you Resume."
                              VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Grid>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button Classes="secondarybtn" Classes.lookahead="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).BarSecondaryIsLive}" Classes.stopbtn="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarSecondaryIsDestructive}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarSecondaryCommand}" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarSecondaryEnabled}" MinWidth="82" Padding="10,6">
                  <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarSecondaryLabel}" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="primary" Classes.dimmed="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryDimmed}"
                        Classes.resume="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryResume}" Classes.neutral="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryNeutral}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryCommand}" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryEnabled}" MinWidth="82" Padding="10,6">
                  <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryLabel}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="3" Classes="section" BorderThickness="0" Padding="20,10,20,8">
            <StackPanel Spacing="9" Grid.IsSharedSizeScope="True">

              <Grid Margin="0,0,13,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto" MinWidth="84" SharedSizeGroup="CovFiles"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="CovData"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="LIBRARY COVERAGE" Foreground="White" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="FILES" Foreground="White" FontSize="12" FontWeight="SemiBold" LetterSpacing="0.6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-1"/>
                <Border Grid.Column="3" Width="1" Background="{StaticResource StrokeSubtle}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,4,0,-2"/>
                <TextBlock Grid.Column="4" Text="{Binding CoverageDataHeader}" Foreground="White" FontSize="12" FontWeight="SemiBold" LetterSpacing="0.6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-1"/>

                <Border Grid.Column="1" Height="1" Background="{StaticResource NeutralRuleFade}" Margin="10,0,10,0" VerticalAlignment="Center"/>
              </Grid>

              <Border Background="{StaticResource SurfaceBg}" CornerRadius="{StaticResource RadiusChip}" Padding="12,8,12,8"
                      BorderBrush="{StaticResource FlatEdge}" BorderThickness="1">
                <StackPanel Spacing="7">

              <Grid RowDefinitions="Auto,7,Auto,6,Auto,4,Auto">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto" MinWidth="84" SharedSizeGroup="CovFiles"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="CovData"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="4" Grid.RowSpan="7" Width="1" Background="{StaticResource StrokeSubtle}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                <TextBlock Grid.Column="0" Text="Games" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontRow}" VerticalAlignment="Center"/>

                <ProgressBar Grid.Column="2" Height="10" Minimum="0" Maximum="100" Value="{Binding GamesBytePercent}" CornerRadius="{StaticResource RadiusChip}" Margin="0,0,10,0"
                             Foreground="{StaticResource AccentAmber}" Background="{StaticResource PlotRecess}"
                             BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1"/>
                <TextBlock Grid.Column="1" Text="{Binding GamesBytePercentText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontRow}" FontWeight="SemiBold" FontFamily="Consolas,monospace" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Grid Grid.Row="0" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CovFilesDone"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="CovFilesTotal"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding GamesFilesDoneText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="1" Text=" / " Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}"/>
                  <TextBlock Grid.Column="2" Text="{Binding GamesFilesTotalText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CovDataDone"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="CovDataTotal"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding GamesDataDoneText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="1" Text=" / " Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}"/>
                  <TextBlock Grid.Column="2" Text="{Binding GamesDataTotalText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Extras" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontRow}" VerticalAlignment="Center"/>

                <Border Grid.Row="2" Grid.Column="2" Height="10" CornerRadius="{StaticResource RadiusChip}" Margin="0,0,10,0" ClipToBounds="True"
                        Background="{StaticResource PlotRecess}" BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1"
                        VerticalAlignment="Center">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="{Binding ExtraCol0}"/><ColumnDefinition Width="{Binding ExtraCol1}"/>
                      <ColumnDefinition Width="{Binding ExtraCol2}"/><ColumnDefinition Width="{Binding ExtraCol3}"/>
                      <ColumnDefinition Width="{Binding ExtraCol4}"/><ColumnDefinition Width="{Binding ExtraCol5}"/>
                      <ColumnDefinition Width="{Binding ExtraCol6}"/><ColumnDefinition Width="{Binding ExtraColRest}"/>
                    </Grid.ColumnDefinitions>
                    <Panel Grid.Column="0" Background="{Binding ExtraBrush0}"/>
                    <Panel Grid.Column="1" Background="{Binding ExtraBrush1}"/>
                    <Panel Grid.Column="2" Background="{Binding ExtraBrush2}"/>
                    <Panel Grid.Column="3" Background="{Binding ExtraBrush3}"/>
                    <Panel Grid.Column="4" Background="{Binding ExtraBrush4}"/>
                    <Panel Grid.Column="5" Background="{Binding ExtraBrush5}"/>
                    <Panel Grid.Column="6" Background="{Binding ExtraBrush6}"/>
                  </Grid>
                </Border>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExtrasBytePercentText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontRow}" FontWeight="SemiBold" FontFamily="Consolas,monospace" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Grid Grid.Row="2" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CovFilesDone"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="CovFilesTotal"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding ExtrasFilesDoneText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="1" Text=" / " Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}"/>
                  <TextBlock Grid.Column="2" Text="{Binding ExtrasFilesTotalText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CovDataDone"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="CovDataTotal"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding ExtrasDataDoneText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="1" Text=" / " Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}"/>
                  <TextBlock Grid.Column="2" Text="{Binding ExtrasDataTotalText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFeatures="tnum" HorizontalAlignment="Right"/>
                </Grid>

                <Border Grid.Row="4" Grid.Column="3" Grid.ColumnSpan="3" Height="1" Background="{StaticResource StrokeSubtle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Total" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>

                <Grid Grid.Row="6" Grid.Column="2" VerticalAlignment="Center">
              <ItemsControl ItemsSource="{Binding ExtraSegments}" Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{Binding HasExtraSegments}">

              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExtraTypeSegment">

                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,3" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DoneBytesText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
                </Grid>
                <Grid Grid.Row="6" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CovFilesDone"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="CovFilesTotal"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding TotalCovFilesDoneText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" FontFeatures="tnum" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="1" Text=" / " Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}"/>
                  <TextBlock Grid.Column="2" Text="{Binding TotalCovFilesTotalText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" FontFeatures="tnum" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="6" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CovDataDone"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="CovDataTotal"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding TotalCovDataDoneText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" FontFeatures="tnum" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="1" Text=" / " Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}"/>
                  <TextBlock Grid.Column="2" Text="{Binding TotalCovDataTotalText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" FontFeatures="tnum" HorizontalAlignment="Right"/>
                </Grid>
              </Grid>
                </StackPanel>
              </Border>

              <Border Height="0" Margin="0,7,0,0"/>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,1">
                <TextBlock Grid.Column="0" Text="STORAGE STATUS" Foreground="White" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <Border Grid.Column="1" Height="1" Background="{StaticResource NeutralRuleFade}" Margin="10,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="9" Height="9" CornerRadius="2" Background="{StaticResource AccentAmber}" VerticalAlignment="Center"/>
                    <TextBlock Text="Grog" Foreground="White" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="9" Height="9" CornerRadius="2" Background="{StaticResource StrokeSubtle}" VerticalAlignment="Center"/>
                    <TextBlock Text="Other data" Foreground="White" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"
                               ToolTip.Tip="Anything on the drive that is not Grog's, including the filesystem's own bookkeeping - the same 'used' Explorer shows"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.WaitingDriveText}"
                         IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.HasWaitingDrive}"
                         Foreground="White" FontSize="{StaticResource FontCaption}" Margin="0,0,0,6"/>

              <Border Background="{StaticResource SurfaceBg}" CornerRadius="{StaticResource RadiusChip}" Padding="12,9,12,10"
                      BorderBrush="{StaticResource FlatEdge}" BorderThickness="1">
                <StackPanel Spacing="9">
              <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.BackupLocations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackupLocationRow">

                    <Grid ColumnDefinitions="96,96,*,260" Margin="0,1,0,0">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontRow}" VerticalAlignment="Center"/>

                      <TextBlock Grid.Column="1" Text="{Binding GrogSizeText}" Foreground="{StaticResource InkPrimary}"
                                 IsVisible="{Binding IsOnline}"
                                 FontSize="{StaticResource FontRow}" FontWeight="SemiBold" FontFamily="Consolas,monospace"
                                 HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Height="10" CornerRadius="{StaticResource RadiusChip}" Margin="0,0,10,0" ClipToBounds="True"
                              IsVisible="{Binding IsOnline}" ToolTip.Tip="{Binding BarToolTip}"
                              Background="{StaticResource PlotRecess}" BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1"
                              VerticalAlignment="Center">
                        <Grid>

                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding GrogCol}"/><ColumnDefinition Width="{Binding QueuedCol}"/><ColumnDefinition Width="{Binding OtherCol}"/><ColumnDefinition Width="{Binding FreeCol}"/>
                          </Grid.ColumnDefinitions>
                          <Panel Grid.Column="0" Background="{StaticResource AccentAmber}"/>
                          <Panel Grid.Column="1" Background="{Binding QueuedSegmentBrush}"/>
                          <Panel Grid.Column="2" Background="{StaticResource StrokeSubtle}"/>
                        </Grid>
                      </Border>

                      <Grid Grid.Column="3" Width="260" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsOnline}"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="{Binding CapacityFreeText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}"/>
                        <TextBlock Grid.Column="1" Text="free of" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}" HorizontalAlignment="Center" Margin="8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding CapacityTotalText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}"/>
                      </Grid>
                      <TextBlock Grid.Column="3" Text="{Binding StatusWord}" Foreground="{Binding StateBrush}" FontSize="{StaticResource FontBody}"
                                 FontWeight="SemiBold" IsVisible="{Binding !IsOnline}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryNotSaved}" Padding="9,6"
                      Background="{StaticResource SurfaceAmberSoft}" BorderBrush="{StaticResource StrokeAmberSoft}"
                      BorderThickness="1" CornerRadius="{StaticResource RadiusChip}">
                <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LibraryNotSavedLine}" Foreground="{StaticResource AccentAmber}"
                           FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </Border>

              <Border IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QueueHasUnplaceable}" Padding="9,6"
                      Background="{StaticResource SurfaceErrorSoft}" BorderBrush="{StaticResource StrokeErrorSoft}"
                      BorderThickness="1" CornerRadius="{StaticResource RadiusChip}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QueueUnplaceableLine}" Foreground="{StaticResource ErrorRedBright}"
                             FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>

                  <Button Grid.Column="1" Classes="ghost" Content="Show files in Queue" Padding="10,5" FontSize="{StaticResource FontEyebrow}" VerticalAlignment="Center" Command="{Binding ShowWontFitCommand}"/>

                  <Button Grid.Column="2" Classes="primary" Content="Add second storage" Padding="10,5" FontSize="{StaticResource FontEyebrow}" VerticalAlignment="Center"
                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.CanAddSecondary}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddSecondaryStorageFromBannerCommand}"/>

                </Grid>
              </Border>
                </StackPanel>
              </Border>

            </StackPanel>
          </Border>

      </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="1" Classes="scard" Margin="0,0,0,14" VerticalAlignment="Top">
      <StackPanel Spacing="0">
        <Border Classes="shead">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="sgh" Text="SCHEDULE"/>
            <Border Grid.Column="1" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>

            <Button Grid.Column="2" Classes="secondarybtn" Padding="10,4"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}" CommandParameter="Settings"
                    ToolTip.Tip="Backup schedule is set in Settings" VerticalAlignment="Center">
              <TextBlock Text="Change in Settings" FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold"/>
            </Button>
          </Grid>
        </Border>

      <Grid ColumnDefinitions="*,1,*,1,Auto" DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Schedule}" x:DataType="vm:ScheduleViewModel">
        <StackPanel Grid.Column="0" Spacing="4" Margin="18,12,18,13">
          <TextBlock Classes="eyebrow" Text="NEXT RUN"/>
          <TextBlock Text="{Binding NextRunValue}" Foreground="{Binding NextRunBrush}" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding NextRunSub}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource StrokeSubtle}"/>
        <StackPanel Grid.Column="2" Spacing="4" Margin="18,12,18,13">
          <TextBlock Classes="eyebrow" Text="LAST COMPLETED RUN"/>
          <TextBlock Text="{Binding LastRunValue}" Foreground="{Binding LastRunBrush}" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" TextWrapping="Wrap"/>

          <TextBlock Text="{Binding LastRunSub}" Foreground="{Binding LastRunSubBrush}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"
                     IsVisible="{Binding LastRunSub, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        <Border Grid.Column="3" Background="{StaticResource StrokeSubtle}"/>
        <StackPanel Grid.Column="4" Spacing="4" Margin="18,12,18,13" MinWidth="150">
          <TextBlock Classes="eyebrow" Text="LAST RUN RESULT"/>
          <TextBlock Text="{Binding LastRunResultValue}" Foreground="{Binding LastRunResultBrush}" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding LastRunResultSub}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"
                     IsVisible="{Binding LastRunResultSub, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </Grid>
      </StackPanel>
    </Border>

    <Border x:Name="GuideActivityArea" Grid.Row="2" Classes="scard">

      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="shead">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Classes="sgh" Text="BACKUP TASK"/>
            <Border Grid.Column="1" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>

            <Button Grid.Column="2" Classes="secondarybtn" Padding="10,4"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}" CommandParameter="Library"
                    ToolTip.Tip="Pick what to back up on the Library page" VerticalAlignment="Center">
              <TextBlock Text="Queue in Library" FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold"/>
            </Button>
          </Grid>
        </Border>
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Padding="20,9">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <TextBlock Grid.Column="0" Text="{Binding RunLedeValue}" Foreground="{Binding RunLedeBrush}" FontSize="27"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontFeatures="+tnum" MinWidth="132"/>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding RunLedeHeadline}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap"
                             IsVisible="{Binding RunLedePausedReason, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>

                  <TextBlock Text="{Binding RunLedePausedReason}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"
                             IsVisible="{Binding RunLedePausedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <TextBlock Text="{Binding RunLedeDetail}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                             IsVisible="{Binding RunLedeDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

              </Grid>
              <StackPanel Spacing="5">
                <Border Height="14" CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1" ClipToBounds="True">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding RunDoneCol}"/><ColumnDefinition Width="{Binding RunRemainCol}"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource AccentAmber}"/>
                  </Grid>
                </Border>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding TaskBarValueText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontBody}" FontFamily="Consolas,monospace"/>
                </Grid>
              </StackPanel>
            </StackPanel>                </Border>
        <Border Grid.Row="1" Classes="section" Padding="20,9,20,9">

          <Grid ColumnDefinitions="*,1,*,2,*,1,*">
            <StackPanel VerticalAlignment="Top" Grid.Column="0" Spacing="4" Margin="0,0,12,0">
              <TextBlock Classes="eyebrow" Text="ELAPSED"/>
              <TextBlock Text="{Binding ElapsedText}" Foreground="{StaticResource InkPrimary}" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace"/>
              <TextBlock Text="{Binding ElapsedInlineText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource StrokeSubtle}"/>
            <StackPanel VerticalAlignment="Top" Grid.Column="2" Spacing="4" Margin="12,0">
              <TextBlock Classes="eyebrow" Text="SPEED"/>
              <TextBlock Text="{Binding CurrentSpeedText}" Foreground="{StaticResource InkPrimary}" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace"/>
              <TextBlock Text="{Binding AvgSpeedInlineText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="3" Background="{StaticResource InkDim}" Opacity="0.55"/>
            <StackPanel VerticalAlignment="Top" Grid.Column="4" Spacing="4" Margin="12,0">

              <WrapPanel><TextBlock Classes="eyebrow" Text="FILES LEFT" Margin="0,0,5,0"/><TextBlock Classes="eyebrow" Text="(WHAT FITS)" IsVisible="{Binding HasWontFitStats}"/></WrapPanel>
              <TextBlock Text="{Binding FilesLeftText}" Foreground="{StaticResource InkPrimary}" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace"/>
              <TextBlock Text="{Binding FilesDoneInlineText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="5" Background="{StaticResource StrokeSubtle}"/>
            <StackPanel VerticalAlignment="Top" Grid.Column="6" Spacing="4" Margin="12,0,0,0">

              <WrapPanel><TextBlock Classes="eyebrow" Text="EST. TIME LEFT" Margin="0,0,5,0"/><TextBlock Classes="eyebrow" Text="(WHAT FITS)" IsVisible="{Binding HasWontFitStats}"/></WrapPanel>
              <TextBlock Text="{Binding EtaText}" Foreground="{StaticResource InkPrimary}" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas,monospace"/>
              <TextBlock Text="{Binding FinishClockText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Padding="18,11,18,10" BorderBrush="{StaticResource StrokeSubtle}" BorderThickness="0,1,0,0">
      <Panel>

        <TextBlock Text="Speed and time remaining appear while a backup runs" Foreground="{StaticResource InkDim}"
                   FontSize="{StaticResource FontCaption}" VerticalAlignment="Top" IsVisible="{Binding !RunActive}"/>
      <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding RunActive}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Classes="eyebrow" Text="SPEED OVER TIME"/>
          <TextBlock Grid.Column="2" Text="last 60s" Foreground="White" FontSize="13" FontFamily="Consolas,monospace"/>
        </Grid>

          <Panel Grid.Row="1" MinHeight="38">
          <Border CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource PlotRecess}" BorderBrush="{StaticResource FlatEdge}"
                  BorderThickness="1" ClipToBounds="True" IsVisible="{Binding ShowSpeedGraph}">
            <Panel>

              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" HorizontalAlignment="Stretch" Fill="{StaticResource InkMuted}" Opacity="0.18"/>
                <Rectangle Grid.Row="2" VerticalAlignment="Top" Height="1" HorizontalAlignment="Stretch" Fill="{StaticResource InkMuted}" Opacity="0.18"/>
              </Grid>

              <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Path Data="{Binding SpeedGraphGeometry}" Fill="{StaticResource SpeedTraceFill}" Width="1000" Height="100"/>
              </Viewbox>

              <Grid Margin="7,5,7,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="{Binding SpeedAboveAvgRow}"/>
                  <RowDefinition Height="{Binding SpeedBelowAvgRow}"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding SpeedPeakText}" VerticalAlignment="Top" HorizontalAlignment="Right"
                           Foreground="White" FontSize="{StaticResource FontEyebrow}" FontFamily="Consolas,monospace"/>
                <Rectangle Grid.Row="1" VerticalAlignment="Top" Height="1" HorizontalAlignment="Stretch"
                           Stroke="{StaticResource InkMuted}" StrokeThickness="1" StrokeDashArray="4,3"/>
                <TextBlock Grid.Row="1" Text="{Binding SpeedAvgTag}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,0,0"
                           Foreground="White" FontSize="13" FontFamily="Consolas,monospace"/>
              </Grid>
            </Panel>
          </Border>
          <Border CornerRadius="{StaticResource RadiusChip}" Background="{StaticResource PlotRecess}" BorderBrush="{StaticResource FlatEdge}"
                  BorderThickness="1" IsVisible="{Binding !ShowSpeedGraph}">

          </Border>
        </Panel>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Height="15" Margin="0,4,0,0">
          <TextBlock Grid.Column="0" Text="-60s" Foreground="White" FontSize="13" FontFamily="Consolas,monospace" IsVisible="{Binding ShowSpeedGraph}"/>
          <TextBlock Grid.Column="2" Text="now" Foreground="White" FontSize="13" FontFamily="Consolas,monospace" IsVisible="{Binding ShowSpeedGraph}"/>
        </Grid>
      </Grid>
      </Panel>
        </Border>
      </Grid>
      </Grid>
    </Border>

  </Grid>
  </ScrollViewer>

  <GridSplitter Classes="dividerflat" Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch"/>

  <Grid Grid.Column="2" Margin="8,0,14,0" RowDefinitions="69,Auto,*">
    <Border Grid.Row="1" Grid.RowSpan="2" Classes="scard" CornerRadius="12,12,0,0">

      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="shead">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Classes="sgh" Text="ACTIVITY"/>
            <Border Grid.Column="1" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>
          </Grid>
        </Border>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>

        <RowDefinition Height="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ActivityTopHeight, Mode=TwoWay}" MinHeight="200"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" VerticalAlignment="Stretch">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12,16,6">

            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
              <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{StaticResource SuccessGreen}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.IsReorgRunning}"/>
              <TextBlock Grid.Column="1" Text="Moving" FontSize="{StaticResource FontRow}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>

              <TextBlock Grid.Column="2" IsVisible="{Binding ShowMoveCount}" Text="{Binding MoveCountText}" Foreground="{StaticResource InkDim}"
                         FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <Border Grid.Column="3" Height="1.5" Background="{StaticResource NeutralRuleFade}" Margin="12,0,8,0" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ShowMoveTransport}">

              <Button Classes="ghost" Content="Cancel" FontSize="{StaticResource FontCaption}" Padding="12,5"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.DismissReorgCommand}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveWaitingForSlot}"/>

              <Button Classes="ghost" Content="Stop" FontSize="{StaticResource FontCaption}" Padding="12,5" Foreground="{StaticResource ErrorRed}"
                      BorderBrush="{StaticResource StrokeErrorSoft}" Background="{StaticResource SurfaceErrorSoft}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.CancelActiveReorgCommand}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.IsReorgRunning}"/>
              <Button Classes="ghost" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgPauseLabel}" FontSize="{StaticResource FontCaption}" Padding="12,5" Foreground="{StaticResource AccentAmber}"
                      BorderBrush="{StaticResource StrokeAmberSoft}" Background="{StaticResource SurfaceAmberSoft}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.PauseReorgCommand}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ShowPauseReorg}" IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgPausing}"/>
              <Button Classes="ghost" Content="Resume" FontSize="{StaticResource FontCaption}" Padding="12,5" Foreground="{StaticResource AccentAmber}"
                      BorderBrush="{StaticResource StrokeAmberSoft}" Background="{StaticResource SurfaceAmberSoft}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ResumePausedReorgCommand}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgPaused}"/>
            </StackPanel>
          </Grid>

          <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource SurfaceStroke}"
                  BorderThickness="0,1,0,0" Padding="16,7" IsVisible="{Binding ShowMoveCount}">

            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveStatsText}" Foreground="White" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Center"/>
          </Border>

          <Border DockPanel.Dock="Top" Margin="16,2,16,6" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource FlatEdge}"
                  BorderThickness="1" CornerRadius="{StaticResource RadiusChip}" Padding="12">
            <Panel>

              <ContentControl IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.HasReorgActive}" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgActive}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:ReorgMoveRow">

                    <StackPanel Spacing="5">
                      <TextBlock Text="{Binding Title}" Foreground="White" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathText}"/>
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding FileName}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding PathText}"/>
                        <Border Grid.Column="1" Classes="osbadge" Margin="7,0,0,0" IsVisible="{Binding ShowOsBadge}" BorderBrush="{StaticResource InkDim}">
                          <TextBlock Text="{Binding OsBadge}" Foreground="{StaticResource InkDim}"/>
                        </Border>
                      </Grid>
                      <ProgressBar Value="{Binding Percent}" Maximum="100" Height="7" CornerRadius="{StaticResource RadiusChip}" Foreground="{StaticResource AccentAmber}" Background="{StaticResource SurfaceBg}"/>
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgPillState}"
                                   Foreground="{StaticResource AccentAmber}" FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="White" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding RouteText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>

              <ContentControl IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.HasReorgPillNext}" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgPillNext}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:ReorgMoveRow">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontEyebrow}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgPillState}" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontEyebrow}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      </Grid>
                      <TextBlock Text="{Binding PathText}" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontEyebrow}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" FontFamily="Consolas,monospace"/>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>

              <TextBlock IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgPillIdle}" Text="Files can be moved between locations on the Storage page" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" LineHeight="16" VerticalAlignment="Center" Margin="2,0,0,0" TextWrapping="Wrap"/>
            </Panel>
          </Border>
          <StackPanel DockPanel.Dock="Top" Margin="16,2,16,0" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.HasReorgTail}">

              <WrapPanel Orientation="Horizontal" Margin="0,2,0,6" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.HasReorgTail}">

                <TextBlock Text="Order by" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" Margin="0,0,8,4" IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).NarrowChrome}"/>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortIsInstallers}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.SortMovesCommand}" CommandParameter="Kind" ToolTip.Tip="Game installers before extras">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortLabelInstallers}"/><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortGlyphInstallers}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortIsExtras}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.SortMovesCommand}" CommandParameter="Extras" ToolTip.Tip="Extras before game installers">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortLabelExtras}"/><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortGlyphExtras}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortIsGame}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.SortMovesCommand}" CommandParameter="Game" ToolTip.Tip="Sort the moves alphabetically by game title">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="Name"/><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortGlyphGame}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortIsSize}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.SortMovesCommand}" CommandParameter="Size" ToolTip.Tip="Sort the moves by file size">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="Size"/><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.MoveSortGlyphSize}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
              </WrapPanel>
              <Border Height="1" Background="{StaticResource SurfaceStroke}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.HasReorgTail}"/>
          </StackPanel>

          <ScrollViewer>
              <ItemsControl x:Name="MoveWaitingList" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ReorgTail}" Margin="16,6,16,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReorgMoveRow">
                    <StackPanel Background="Transparent" Tag="{Binding}">
                    <Border Height="2" CornerRadius="1" Background="{StaticResource AccentAmber}" IsVisible="{Binding DropLineAbove}" Margin="0,0,0,2"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,1" Background="Transparent">
                      <TextBlock Grid.Column="0" Text="&#10303;" Foreground="{StaticResource InkFaint}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Drag to reorder"/>
                      <StackPanel Grid.Column="1" Spacing="0" Margin="0,3" ToolTip.Tip="{Binding PathText}">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="White" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="2" CornerRadius="1" Background="{StaticResource AccentAmber}" IsVisible="{Binding DropLineBelow}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
          </ScrollViewer>
        </DockPanel>
    <GridSplitter Classes="dividerh" Grid.Row="1" Height="12" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

    <DockPanel Grid.Row="2" MinHeight="200">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12,16,6">

            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
              <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{StaticResource AccentAmber}" IsVisible="{Binding HasActive}"/>
              <TextBlock Grid.Column="1" Text="Downloading" FontSize="{StaticResource FontRow}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" IsVisible="{Binding HasQueuedWork}" Text="{Binding DownloadCountText}" Foreground="{StaticResource InkDim}"
                         FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <Border Grid.Column="3" Height="1.5" Background="{StaticResource NeutralRuleFade}" Margin="12,0,8,0" VerticalAlignment="Center"/>
            </Grid>
            <Panel Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding HasQueuedWork}">

              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ghost" Content="Clear queue…" FontSize="{StaticResource FontCaption}" Padding="12,5" Foreground="{StaticResource ErrorRed}"
                        BorderBrush="{StaticResource StrokeErrorSoft}" Background="{StaticResource SurfaceErrorSoft}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RequestClearQueueCommand}" IsVisible="{Binding HasQueuedWork}"
                        ToolTip.Tip="Clear the download queue - stops the current file too. Partial downloads are kept, so re-queuing resumes where it left off."/>

                <Button Classes="ghost" Content="{Binding QueueConnectLabel}" FontSize="{StaticResource FontCaption}" Padding="12,5" Foreground="{StaticResource AccentAmber}"
                        BorderBrush="{StaticResource StrokeAmberSoft}" Background="{StaticResource SurfaceAmberSoft}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Accounts.ConnectOrAddAccountCommand}" IsVisible="{Binding ShowQueueConnectAccount}"/>
              </StackPanel>
            </Panel>
          </Grid>

          <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource SurfaceStroke}"
                  BorderThickness="0,1,0,0" Padding="16,7" IsVisible="{Binding ShowDownloadStats}">

            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="{Binding DownloadStatsText}" Foreground="White" FontSize="{StaticResource FontCaption}" Margin="0,0,10,0" IsVisible="{Binding ShowReachStats}"/>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasWontFitStats}">
                <TextBlock Text="·" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" IsVisible="{Binding ShowReachStats}"/>
                <TextBlock Text="{Binding WontFitStatsText}" Foreground="{StaticResource ErrorRedBright}" FontWeight="SemiBold" FontSize="{StaticResource FontCaption}"/>
              </StackPanel>
            </WrapPanel>
          </Border>

          <Border DockPanel.Dock="Top" Margin="16,2,16,6" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource FlatEdge}"
                  BorderThickness="1" CornerRadius="{StaticResource RadiusChip}" Padding="12">
            <Panel>
              <ContentControl IsVisible="{Binding !DownloadPillIdle}" Content="{Binding DownloadPill}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:QueueRow">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="*,Auto">

                        <TextBlock Grid.Column="0" Text="{Binding GameTitle}" Foreground="White" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LabelText}"/>
                        <Button Grid.Column="1" Classes="linky" FontSize="{StaticResource FontCaption}" Foreground="{StaticResource InkDim}" Content="&#10005;"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.CancelQueueRowCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="Cancel this file (keeps the partial download)"/>
                      </Grid>
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*">

                        <TextBlock Grid.Column="0" Text="{Binding FileNameText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding LabelText}" IsVisible="{Binding ShowFileLine}"/>

                        <Border Grid.Column="1" Classes="typechip" Background="{Binding ExtraTypeFill}" BorderBrush="{Binding ExtraTypeBorder}" Margin="7,0,0,0" IsVisible="{Binding IsExtra}">
                          <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding ExtraTypeText}"/>
                        </Border>
                        <Border Grid.Column="2" Classes="osbadge" Margin="7,0,0,0" IsVisible="{Binding ShowOsBadge}" BorderBrush="{Binding OsBadgeBrush}">
                          <TextBlock Text="{Binding OsBadge}" Foreground="{Binding OsBadgeBrush}"/>
                        </Border>
                      </Grid>
                      <ProgressBar Value="{Binding Percent}" Maximum="100" Height="7" CornerRadius="{StaticResource RadiusChip}" Foreground="{StaticResource AccentAmber}" Background="{StaticResource SurfaceBg}"/>

                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.DownloadPillState}"
                                   Foreground="{StaticResource AccentAmber}" FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="White" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding RateText}" Foreground="White" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding TargetText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <TextBlock IsVisible="{Binding DownloadPillIdle}" Text="{Binding DownloadPillIdleText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" LineHeight="16" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Panel>
          </Border>

          <StackPanel DockPanel.Dock="Top" Margin="16,2,16,0" IsVisible="{Binding HasDownloadTail}">

              <WrapPanel Orientation="Horizontal" Margin="0,2,0,6">

                <TextBlock Text="Order by" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" Margin="0,0,8,4" IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).NarrowChrome}"/>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding QueueSortIsInstallers}"
                        Command="{Binding SortQueueCommand}" CommandParameter="Kind" ToolTip.Tip="Game installers before extras">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortLabelInstallers}"/><Run Text="{Binding QueueSortGlyphInstallers}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding QueueSortIsExtras}"
                        Command="{Binding SortQueueCommand}" CommandParameter="Extras" ToolTip.Tip="Extras before game installers">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortLabelExtras}"/><Run Text="{Binding QueueSortGlyphExtras}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding QueueSortIsGame}"
                        Command="{Binding SortQueueCommand}" CommandParameter="Game" ToolTip.Tip="Sort the queue alphabetically by game title">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="Name"/><Run Text="{Binding QueueSortGlyphGame}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
                <Button Classes="qsort" Margin="0,0,6,4" Classes.sel="{Binding QueueSortIsSize}"
                        Command="{Binding SortQueueCommand}" CommandParameter="Size" ToolTip.Tip="Sort the queue by file size">
                  <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="Size"/><Run Text="{Binding QueueSortGlyphSize}" Foreground="{StaticResource AccentAmber}"/></TextBlock>
                </Button>
              </WrapPanel>

              <Border Height="1" Background="{StaticResource SurfaceStroke}" Margin="0,0,0,0"/>
          </StackPanel>

          <ScrollViewer>
              <ItemsControl x:Name="WaitingList" ItemsSource="{Binding DownloadTail}" Margin="16,6,16,8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.DataTemplates>
                  <DataTemplate DataType="vm:WontFitDividerRow" x:DataType="vm:WontFitDividerRow">

                    <Border Background="{StaticResource SurfaceErrorSoft}" BorderBrush="{StaticResource StrokeErrorSoft}" BorderThickness="0,1,0,1" Margin="0,4,0,1" Padding="0,2,6,4">

                      <StackPanel Spacing="2">
                        <Border Height="2" CornerRadius="1" Background="{StaticResource AccentAmber}" IsVisible="{Binding DropLineAbove}" Margin="0,0,0,2"/>
                        <Grid ColumnDefinitions="Auto,*">
                          <Button Grid.Column="0" Classes="linky" Foreground="{StaticResource ErrorRedBright}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center" Padding="0,4,8,4"
                                  Content="{Binding Caret}" ToolTip.Tip="{Binding Tip}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.ToggleWontFitDividerCommand}"/>
                          <Button Grid.Column="1" Classes="linky" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0,4" ToolTip.Tip="These stay queued and download when room frees up (a second storage, or files removed above). Remove them if you do not want them. Click to show or hide them."
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.ToggleWontFitDividerCommand}">
                            <TextBlock Text="{Binding Text}" Foreground="{StaticResource ErrorRedBright}" FontSize="{StaticResource FontCaption}" FontWeight="Bold" TextWrapping="Wrap"/>
                          </Button>
                        </Grid>
                        <WrapPanel Margin="18,0,0,0">

                          <Button Classes="ghost" Content="Pull up what fits" Padding="10,4" Margin="0,0,8,0" FontSize="{StaticResource FontEyebrow}" ToolTip.Tip="Move the files below that fit in the free space above the line, keeping their order"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.PullUpWhatFitsCommand}"/>

                          <Button Classes="ghost" Content="{Binding RemoveLabel}" Padding="10,4" FontSize="{StaticResource FontEyebrow}" Foreground="{StaticResource ErrorRedBright}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.RemoveWontFitCommand}"/>
                        </WrapPanel>
                        <Border Height="2" CornerRadius="1" Background="{StaticResource AccentAmber}" IsVisible="{Binding DropLineBelow}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                  <DataTemplate DataType="vm:QueueRow" x:DataType="vm:QueueRow">
                    <StackPanel Spacing="3" Margin="0,0,0,1" Tag="{Binding}" Classes="qrow" Classes.moved="{Binding JustMoved}">
                      <StackPanel.Styles>

                        <Style Selector="StackPanel.qrow"><Setter Property="Background" Value="Transparent"/></Style>
                        <Style Selector="StackPanel.qrow.moved"><Setter Property="Background" Value="{StaticResource SurfaceAmberSoft}"/></Style>
                      </StackPanel.Styles>

                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Download this next" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.MoveQueueRowToFrontCommand}" CommandParameter="{Binding}"/>

                          <MenuItem Header="Pull up if it fits" IsVisible="{Binding WontFit}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.PullUpRowCommand}" CommandParameter="{Binding}"/>
                          <MenuItem Header="Move to the end" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.MoveQueueRowToEndCommand}" CommandParameter="{Binding}"/>
                          <Separator/>
                          <MenuItem Header="Remove from the queue" Foreground="{StaticResource ErrorRedBright}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.CancelQueueRowCommand}" CommandParameter="{Binding}"/>
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                      <Border Height="2" CornerRadius="1" Background="{StaticResource AccentAmber}" IsVisible="{Binding DropLineAbove}" Margin="0,0,0,2"/>

                      <Grid ColumnDefinitions="Auto,*,116,88,24" RowDefinitions="Auto,Auto">

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding WontFitText}" ToolTip.Tip="{Binding WontFitTip}" Foreground="{StaticResource ErrorRedBright}" FontSize="{StaticResource FontEyebrow}" FontWeight="Bold" LetterSpacing="0.6" TextAlignment="Right" Margin="0,1,0,0" IsVisible="{Binding ShowWontFitLong}"/>
                        <TextBlock Grid.Column="0" Text="&#10303;" Foreground="{StaticResource InkFaint}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Drag to reorder"/>
                        <StackPanel Grid.Column="1" Spacing="1" Margin="0,6" ToolTip.Tip="{Binding LabelText}">
                          <TextBlock Text="{Binding GameTitle}" Foreground="White" FontSize="{StaticResource FontBody}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding FileNameText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowFileLine}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Classes="typechip" Background="{Binding ExtraTypeFill}" BorderBrush="{Binding ExtraTypeBorder}" Margin="8,0,0,0" HorizontalAlignment="Right" IsVisible="{Binding IsExtra}">
                          <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding ExtraTypeText}"/>
                        </Border>
                        <Border Grid.Column="2" Classes="osbadge" Margin="8,0,0,0" HorizontalAlignment="Right" IsVisible="{Binding ShowOsBadge}" BorderBrush="{Binding OsBadgeBrush}">
                          <TextBlock Text="{Binding OsBadge}" Foreground="{Binding OsBadgeBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center" Margin="8,0,0,0">
                          <TextBlock Text="{Binding SizeText}" Foreground="White" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="WON'T FIT" Foreground="{StaticResource ErrorRedBright}" FontSize="{StaticResource FontEyebrow}" FontWeight="Bold" LetterSpacing="0.6" TextAlignment="Right" IsVisible="{Binding ShowWontFitShort}"/>

                          <TextBlock Text="NEEDS SIGN-IN" Foreground="{StaticResource WarnOrange}" FontSize="{StaticResource FontEyebrow}" FontWeight="Bold" LetterSpacing="0.6" TextAlignment="Right" IsVisible="{Binding NeedsSignIn}"/>
                        </StackPanel>
                        <Button Grid.Column="4" Classes="linky" Content="&#10005;" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource InkFaint}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Overview.CancelQueueRowCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="Remove from the queue"/>
                      </Grid>

                      <ProgressBar Value="{Binding Percent}" Maximum="100" Height="4" CornerRadius="2" Margin="20,0,0,2"
                                   IsVisible="{Binding ShowBar}"
                                   Foreground="{StaticResource AccentAmber}" Background="{StaticResource SurfaceBg}"/>

                      <Grid IsVisible="{Binding IsActive}" ColumnDefinitions="Auto,*,Auto,Auto" Margin="20,0,0,2">
                        <TextBlock Grid.Column="0" Text="{Binding PhaseText}" Foreground="{StaticResource AccentAmber}" FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding RateText}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center" Margin="12,0,12,0"/>

                        <TextBlock Grid.Column="3" Text="{Binding TargetText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center"/>
                      </Grid>

                      <Border Height="1" Background="{StaticResource FlatRowLine}" Opacity="0.5" Margin="0,3,0,0"/>
                      <Border Height="2" CornerRadius="1" Background="{StaticResource AccentAmber}" IsVisible="{Binding DropLineBelow}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
          </ScrollViewer>
        </DockPanel>
  </Grid>
      </Grid>
    </Border>
  </Grid>
  </Grid>
</UserControl>
