
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Grog.App.ViewModels"
             xmlns:ctl="using:Grog.App.Controls"
             x:Class="Grog.App.Views.Pages.AccountsPage"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Background="Transparent" DataContext="{Binding Accounts}" x:DataType="vm:AccountsViewModel">

    <Grid ColumnDefinitions="Auto,18,*" Margin="14,69,14,0" VerticalAlignment="Top">
    <Grid Grid.Column="0" RowDefinitions="Auto,*">

    <Border Grid.Row="0" Classes="barecard"
            Width="720" HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Spacing="0">
        <Border Classes="shead sheadbare">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Classes="sgh" Text="GOG ACCOUNTS TO BACK UP"/>
            <Border Grid.Column="1" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>
          </Grid>
        </Border>

        <StackPanel Classes="sbody" Spacing="16" Margin="18,18,18,6">

      <ItemsControl x:Name="GuideAccountList" ItemsSource="{Binding Accounts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AccountRow">
            <Border Margin="0,0,0,10" CornerRadius="{StaticResource RadiusControl}" Background="Transparent" BorderBrush="{StaticResource FlatEdge}" BorderThickness="1" ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="16,14">
                  <StackPanel Orientation="Horizontal" Spacing="10">

                    <Border Classes="acctdisc" Background="{Binding Badge.Fill}" IsVisible="{Binding HasBadge}" ToolTip.Tip="{Binding Name}">
                      <TextBlock Text="{Binding Badge.Initials}" Foreground="{Binding Badge.Ink}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource White}" FontWeight="SemiBold" FontSize="{StaticResource FontRow}" VerticalAlignment="Center"/>

                  </StackPanel>

                  <TextBlock Text="{Binding StatsText}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
                  <Button Classes.ghost="{Binding !ActionIsPrimary}" Classes.primary="{Binding ActionIsPrimary}"
                          Classes.attn="{Binding ActionIsAttn}"
                          Content="{Binding ActionText}" FontSize="{StaticResource FontCaption}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Accounts.LogoutAccountCommand}"
                          CommandParameter="{Binding}" VerticalAlignment="Center"
                          ToolTip.Tip="{Binding ActionTip}"/>

                  <Button Classes="ghost" Content="…" FontSize="{StaticResource FontCaption}" Padding="12,8"
                          VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip.Tip="More actions">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Accounts.RemoveAccountCommand}"
                                  CommandParameter="{Binding}">
                          <MenuItem.Header>
                            <StackPanel Spacing="2" MaxWidth="300">
                              <TextBlock Text="Remove account…" Foreground="{StaticResource ErrorRed}" FontSize="{StaticResource FontCaption}"/>
                              <TextBlock Text="Removes this account from Grog. Files already backed up stay on your drives."
                                         Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
                            </StackPanel>
                          </MenuItem.Header>
                        </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button x:Name="GuideAddAccount" Classes="linky" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              Background="Transparent" Command="{Binding ConnectOrAddAccountCommand}"
              ToolTip.Tip="{Binding AddAccountSlotTip}">
        <Panel>
          <Rectangle RadiusX="8" RadiusY="8" Stroke="{StaticResource StrokeAmberSoft}" StrokeThickness="1"
                     StrokeDashArray="4,3" Fill="Transparent"/>
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,15" VerticalAlignment="Center">

            <Border Width="26" Height="26" CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource AccentAmber}">
              <TextBlock Text="+" Foreground="{StaticResource SurfaceBg}" FontSize="{StaticResource FontRow}" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding AddAccountSlotText}"
                       Foreground="{StaticResource AccentAmber}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Panel>
      </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    </Grid>

    <Border Grid.Column="2" Classes="barecard" MaxWidth="380" HorizontalAlignment="Left" VerticalAlignment="Top"
            IsVisible="{Binding ShowTokenSafetyOptions}">
      <StackPanel Spacing="0">
        <Border Classes="shead sheadbare">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Classes="sgh" Foreground="{StaticResource InkDim}" Text="SIGN-IN SECURITY"/>
            <Border Grid.Column="1" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>
          </Grid>
        </Border>
        <StackPanel Classes="sbody" Spacing="10" Margin="18,16,18,18">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding TokenSafetyHeadline}" Foreground="{StaticResource White}"
                       FontWeight="SemiBold" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
          </StackPanel>
          <Border HorizontalAlignment="Left" CornerRadius="3" Padding="7,2"
                  Background="{StaticResource SurfaceAmberSoft}" IsVisible="{Binding TokenSafetyIsFallback}">
            <TextBlock Text="{Binding TokenSafetyBadge}" Foreground="{StaticResource AccentAmberSoft}"
                       FontSize="{StaticResource FontEyebrow}" FontWeight="Bold" LetterSpacing="0.7"/>
          </Border>
          <Border HorizontalAlignment="Left" CornerRadius="3" Padding="7,2"
                  Background="{StaticResource SurfaceRaised}" IsVisible="{Binding !TokenSafetyIsFallback}">
            <TextBlock Text="{Binding TokenSafetyBadge}" Foreground="{StaticResource InkDim}"
                       FontSize="{StaticResource FontEyebrow}" FontWeight="Bold" LetterSpacing="0.7"/>
          </Border>
          <TextBlock Text="{Binding TokenSafetyBody}" Foreground="{StaticResource InkDim}"
                     FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"/>
          <Border Height="1" Background="{StaticResource NeutralRuleFade}" Margin="0,4"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Keep sign-in usable by scheduled tasks"
                       Foreground="{StaticResource White}" FontSize="{StaticResource FontCaption}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PlainTextTokenEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="Only for CLI backups you schedule yourself (cron, systemd timers). Backups scheduled inside Grog do not need it. The token is then stored unencrypted, readable only by your user account."
                     Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
