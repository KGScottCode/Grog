
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Grog.App.ViewModels"
             xmlns:ctl="using:Grog.App.Controls"
             x:Class="Grog.App.Views.Pages.LibraryPage"
             x:DataType="vm:MainWindowViewModel">
  <Panel DataContext="{Binding Library}" x:DataType="vm:LibraryViewModel">

    <Popup x:Name="FolderFilterPopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
      <ctl:FilterPanel Heading="Filter by storage" ItemsSource="{Binding FolderOptions}" FilterKey="folder"
                       AllCommand="{Binding FilterAllCommand}" NoneCommand="{Binding FilterNoneCommand}"/>
    </Popup>

    <Popup x:Name="ExtrasFilterPopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
      <ctl:FilterPanel Heading="Filter by extras type" ItemsSource="{Binding ExtrasOptions}" FilterKey="extras" MinWidth="190"
                       AllCommand="{Binding FilterAllCommand}" NoneCommand="{Binding FilterNoneCommand}"/>
    </Popup>
    <Popup x:Name="OwnerFilterPopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
      <ctl:FilterPanel Heading="Filter by account" ItemsSource="{Binding OwnerOptions}" FilterKey="owner"
                       AllCommand="{Binding FilterAllCommand}" NoneCommand="{Binding FilterNoneCommand}"/>
    </Popup>
    <Popup x:Name="StatusFilterPopup" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True">
      <ctl:FilterPanel Heading="Filter by status" ItemsSource="{Binding StatusOptions}" FilterKey="status"
                       AllCommand="{Binding FilterAllCommand}" NoneCommand="{Binding FilterNoneCommand}"/>
    </Popup>

    <DockPanel LastChildFill="True">

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="{Binding DetailColumnWidth, Mode=TwoWay}" MinWidth="{Binding DetailMinWidth}" MaxWidth="1600"/>
      </Grid.ColumnDefinitions>
      <GridSplitter Classes="dividerflat" Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" ZIndex="20"/>
      <Border Grid.Column="0">
        <DockPanel>

          <Border DockPanel.Dock="Top" Background="Transparent" Padding="14,61,16,3">

            <Border x:Name="LibHead" Background="Transparent" BorderBrush="{StaticResource FlatEdge}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="12,8">
            <Grid x:Name="ActionRow" ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource InkFaint}" StrokeThickness="2"
                      StrokeLineCap="Round" Margin="4,0,6,0" VerticalAlignment="Center"
                      Data="M6 6 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0 M9.5 9.5 L14 14"/>
                <Grid VerticalAlignment="Center">
                  <TextBox Classes="flatsearch" Text="{Binding FilterText}" Width="160"
                           VerticalAlignment="Center" Background="Transparent" FontSize="14.5"
                           Foreground="White" BorderBrush="Transparent" CornerRadius="0" Padding="4,4"/>

                  <TextBlock Text="Search Your GOG Library…" Foreground="{StaticResource InkFaint}" FontSize="14.5"
                             VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"
                             IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                </Grid>

              </StackPanel>

              <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">

                <ScrollViewer x:Name="PillScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">

                    <StackPanel x:Name="PillBar" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                    <TextBlock Text="Filter" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,6,0"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.PillShowCaption}"/>

                    <ItemsControl ItemsSource="{Binding SoftwareChips}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterChip">
                          <Button Classes="chipbtn" Classes.compact="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).Library.PillShowLabel}"
                                  ToolTip.Tip="{Binding Label}" IsVisible="{Binding IsVisible}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.ToggleChipCommand}" CommandParameter="{Binding}">
                            <Border Classes="chipcard" Background="{Binding ChipBackground}" BorderBrush="{Binding ChipBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}">
                              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Border Classes="chiptile" Background="{Binding Swatch}"
                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.PillShowIcon}">
                                  <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Canvas Width="24" Height="24"><Path Data="{Binding Icon}" Fill="White"/></Canvas>
                                  </Viewbox>
                                </Border>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding ChipForeground}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.PillShowLabel}"/>
                              </StackPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="chipdiv" IsVisible="{Binding ShowChipDivider}"/>

                    <ItemsControl ItemsSource="{Binding ExtraFilterChips}" VerticalAlignment="Center">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterChip">
                          <Button Classes="chipbtn" Classes.compact="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).Library.PillShowLabel}"
                                  ToolTip.Tip="{Binding Label}" IsVisible="{Binding IsVisible}"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.ToggleChipCommand}" CommandParameter="{Binding}">
                            <Border Classes="chipcard" Background="{Binding ChipBackground}" BorderBrush="{Binding ChipBorder}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}">
                              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Border Classes="chiptile" Background="{Binding Swatch}"
                                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.PillShowIcon}">
                                  <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Canvas Width="24" Height="24"><Path Data="{Binding Icon}" Fill="White"/></Canvas>
                                  </Viewbox>
                                </Border>
                                <TextBlock Text="{Binding Label}" Foreground="{Binding ChipForeground}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.PillShowLabel}"/>
                              </StackPanel>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
            </Border>
          </Border>

          <Border DockPanel.Dock="Top" IsVisible="{Binding ShowGoneBar}" Background="{StaticResource SurfaceRaised}"
                  BorderBrush="{StaticResource AccentAmber}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Grid.Column="0" Text="{Binding GoneBarText}" Foreground="{StaticResource InkBright}"
                         FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="primary" Content="Back Them Up" Padding="14,5" Margin="10,0,0,0"
                      Command="{Binding BackUpGoneCommand}" IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).Busy}"/>
              <Button Grid.Column="2" Classes="ghost" Content="Mark as Not Backed Up" Padding="14,5" Margin="10,0,0,0"
                      Command="{Binding MarkGoneNotBackedUpCommand}" IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).Busy}"
                      ToolTip.Tip="You deleted these on purpose. Stops calling them missing; nothing on disk changes."/>
            </Grid>
          </Border>

        <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasFilterCount}"
                Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource FlatEdge}"
                BorderThickness="0,1,0,0" Padding="18,5" Margin="6,0,16,3">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding FilterCountText}" Foreground="{StaticResource White}"
                       FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Classes="link" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                    FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" Padding="6,1"
                    ToolTip.Tip="Reset search, chips and the Status / Owner dropdowns to show the whole library."/>
          </Grid>
        </Border>

        <Border Margin="6,3,16,3" Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True">

        <DataGrid x:Name="LibraryGrid" ItemsSource="{Binding Games}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectedItem="{Binding SelectedRow}" SelectionMode="Extended" CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource FlatRowLine}" HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.AllowAutoHide="True"
                  Background="Transparent" Foreground="White" RowBackground="Transparent" FontSize="{StaticResource FontBody}">
          <DataGrid.ContextMenu>

            <ContextMenu>

              <MenuItem Header="{Binding BackUpSelectedLabel}" IsEnabled="{Binding CanAddToQueue}">
                <MenuItem Header="{Binding BackUpAllLabel}"    Command="{Binding SyncSelectedAllCommand}"    IsEnabled="{Binding CanBackUpAll}"/>
                <MenuItem Header="{Binding BackUpGamesLabel}"  Command="{Binding SyncSelectedGamesCommand}"  IsEnabled="{Binding CanBackUpGames}"/>
                <MenuItem Header="{Binding BackUpExtrasLabel}" Command="{Binding SyncSelectedExtrasCommand}" IsEnabled="{Binding CanBackUpExtras}"/>
              </MenuItem>

              <MenuItem Header="{Binding DownloadNextLabel}" Command="{Binding DownloadSelectedNextCommand}" IsEnabled="{Binding CanBackUpAll}"/>
              <Separator/>
              <MenuItem Header="Confirm downloaded" Command="{Binding ConfirmDownloadedCommand}"/>
              <MenuItem Header="Mark as Not Backed Up" Command="{Binding MarkNotBackedUpCommand}"/>
              <MenuItem Header="Mark as Missing" Command="{Binding MarkMissingCommand}"/>
              <Separator/>

              <MenuItem Header="Clear New Status">
                <MenuItem Header="{Binding ClearNewSelectedLabel}" Command="{Binding ClearNewCommand}"/>
                <MenuItem Header="All Items" Command="{Binding ClearAllNewCommand}"/>
              </MenuItem>
              <MenuItem Header="Hide from grid" Command="{Binding HideSelectedCommand}"/>
              <MenuItem Header="Unhide" Command="{Binding UnhideSelectedCommand}" IsVisible="{Binding ShowHiddenItems}"/>
              <Separator/>

              <MenuItem Header="Remove from library" Command="{Binding RemoveSelectedCommand}"/>

              <Separator/>
              <MenuItem Header="Delete downloaded files" Command="{Binding DeleteSelectedCommand}" Foreground="{StaticResource ErrorRedBright}"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Styles>

            <Style Selector="ScrollBar:vertical">
              <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="ScrollBar:vertical /template/ Thumb">
              <Setter Property="Background" Value="{StaticResource RowHoverFill}"/>
            </Style>
            <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
              <Setter Property="Background" Value="{StaticResource RowSelectFill}"/>
            </Style>
            <Style Selector="DataGridColumnHeader">
              <Setter Property="HorizontalContentAlignment" Value="Left"/>
              <Setter Property="Padding" Value="8,6"/>
              <Setter Property="FontSize" Value="13.5"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="White"/>

              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Template">
                <ControlTemplate>
                  <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource FlatEdge}" BorderThickness="0,0,0,1">
                    <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="*,Auto">
                      <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Column="1" Name="SortInd" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Setter>
            </Style>

            <Style Selector="DataGridColumnHeader /template/ TextBlock#SortInd">
              <Setter Property="Text" Value="↕"/><Setter Property="Foreground" Value="{StaticResource StrokeStrongest}"/><Setter Property="FontSize" Value="10"/>
            </Style>
            <Style Selector="DataGridColumnHeader:sortascending /template/ TextBlock#SortInd">
              <Setter Property="Text" Value="↑"/><Setter Property="Foreground" Value="{StaticResource InkBright}"/><Setter Property="FontSize" Value="11"/>
            </Style>
            <Style Selector="DataGridColumnHeader:sortdescending /template/ TextBlock#SortInd">
              <Setter Property="Text" Value="↓"/><Setter Property="Foreground" Value="{StaticResource InkBright}"/><Setter Property="FontSize" Value="11"/>
            </Style>
            <Style Selector="DataGridCell">
              <Setter Property="FontSize" Value="14"/>
              <Setter Property="FocusAdorner" Value="{x:Null}"/>
            </Style>

            <Style Selector="DataGridCell /template/ Control#FocusVisual">
              <Setter Property="IsVisible" Value="False"/>
              <Setter Property="Opacity" Value="0"/>
            </Style>
            <Style Selector="DataGridCell /template/ Control#CurrencyVisual">
              <Setter Property="IsVisible" Value="False"/>
              <Setter Property="Opacity" Value="0"/>
            </Style>

            <Style Selector="DataGridCell /template/ Border#CellBorder">
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
            <Style Selector="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
            <Style Selector="DataGridCell:current"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
            <Style Selector="DataGridCell:selected"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
            <Style Selector="DataGridCell:focus"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
            <Style Selector="DataGridCell:current:focus"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
            <Style Selector="DataGridCell:pointerover"><Setter Property="Background" Value="Transparent"/></Style>

            <Style Selector="DataGridCell.num TextBlock">
              <Setter Property="FontFeatures" Value="+tnum"/>
              <Setter Property="TextAlignment" Value="Right"/>
              <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>
            <Style Selector="DataGridCell"><Setter Property="Padding" Value="8,0,12,0"/></Style>

            <Style Selector="DataGridCell.num"><Setter Property="Padding" Value="8,0,10,0"/></Style>
            <Style Selector="DataGridColumnHeader"><Setter Property="Padding" Value="8,0,12,0"/></Style>

            <Style Selector="DataGridRow">
              <Setter Property="Background" Value="{Binding RowBackground, DataType=vm:GameRowViewModel}"/>
              <Setter Property="ToolTip.Tip" Value="{Binding DelistedTip, DataType=vm:GameRowViewModel}"/>
            </Style>

            <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
              <Setter Property="Fill" Value="{StaticResource SurfaceAmberSoft}"/>
              <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
              <Setter Property="Fill" Value="{StaticResource StrokeAmberSoft}"/>
              <Setter Property="Opacity" Value="1"/>
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="48" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GameRowViewModel">
                  <Border Width="42" Height="42" Background="{StaticResource SurfaceRaisedAlt}" CornerRadius="3" Margin="3,2"
                          VerticalAlignment="Center" ClipToBounds="True"
                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.ShowGridArt}">
                    <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="200" MinWidth="176" CanUserSort="True" SortMemberPath="CompletionPercent">
              <DataGridTemplateColumn.Header>
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="Status" VerticalAlignment="Center" Classes.filteron="{Binding StatusFilterActive}"/>

                  <Button Classes="filterarrow" Classes.filteron="{Binding StatusFilterActive}" Click="OnStatusFilterClick"
                          Background="Transparent" BorderThickness="0" Padding="3,2" Cursor="Hand" ToolTip.Tip="Filter by status">
                    <Path Fill="{StaticResource AccentAmber}" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Data="M 0,0 L 9,0 L 5.5,4 L 5.5,8.5 L 3.5,7 L 3.5,4 Z"/>
                  </Button>
                </StackPanel>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GameRowViewModel">

                  <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding DelistedTip}">

                  <Grid ColumnDefinitions="*,46,Auto" Margin="8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusText}">

                    <Grid Grid.Column="0" Grid.ColumnSpan="{Binding RowDoneSpan}" ColumnDefinitions="*,Auto,*"
                          VerticalAlignment="Center" IsVisible="{Binding ShowRowDone}">
                      <Border Grid.Column="0" Height="2" Margin="4,0,10,0" VerticalAlignment="Center"
                              Background="{StaticResource SuccessRuleFadeIn}"/>
                      <TextBlock Grid.Column="1" Text="{Binding RowMarkGlyph}" Foreground="{Binding RowMarkBrush}"
                                 FontSize="{StaticResource FontRow}" FontWeight="Bold" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Height="2" Margin="10,0,4,0" VerticalAlignment="Center"
                              Background="{StaticResource SuccessRuleFade}"/>
                    </Grid>

                    <Grid Grid.Column="0" Grid.ColumnSpan="{Binding RowIdleSpan}" ColumnDefinitions="*,Auto,*"
                          VerticalAlignment="Center" IsVisible="{Binding ShowRowIdle}">
                      <Border Grid.Column="0" Height="1" Margin="4,0,8,0" VerticalAlignment="Center"
                              Background="{StaticResource RowRuleFadeIn}"/>

                      <TextBlock Grid.Column="1" Text="{Binding RowIdleText}" Foreground="{Binding RowIdleBrush}"
                                 FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Height="1" Margin="8,0,4,0" VerticalAlignment="Center"
                              Background="{StaticResource RowRuleFade}"/>
                    </Grid>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                IsVisible="{Binding ShowRowIssue}">
                      <TextBlock Text="{Binding RowMarkGlyph}" Foreground="{Binding RowMarkBrush}"
                                 FontSize="{StaticResource FontRow}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding RowLabelText}" Foreground="{Binding RowMarkBrush}"
                                 FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="0" Height="6" CornerRadius="3" Background="{StaticResource SurfaceRaised}" Margin="4,0,0,0"
                            VerticalAlignment="Center" ClipToBounds="True" IsVisible="{Binding ShowRowBar}">

                      <ProgressBar Classes="row" MinWidth="0" HorizontalAlignment="Stretch"
                                   Value="{Binding BarValue}" Foreground="{Binding BarBrush}" Background="Transparent"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding RowCountText}" Foreground="{StaticResource InkPrimary}"
                               FontSize="{StaticResource FontCaption}" FontFamily="{StaticResource MonoFont}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="7,0,0,0"
                               IsVisible="{Binding ShowRowCount}"/>
                    <TextBlock Grid.Column="2" Text="{Binding RowPctText}" Foreground="{StaticResource InkPrimary}"
                               FontSize="{StaticResource FontCaption}" FontFamily="{StaticResource MonoFont}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,0,0"
                               IsVisible="{Binding ShowRowPct}"/>
                  </Grid>
                  <TextBlock Text="{Binding OwnerCaption}" Foreground="{StaticResource AccentOrange}"
                             FontSize="11" HorizontalAlignment="Center" Margin="0,1,0,0"
                             IsVisible="{Binding ShowOwnerCaption}"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="Title" Width="*" MinWidth="200" CanUserSort="True" SortMemberPath="Title">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GameRowViewModel">

                  <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">

                    <Button Grid.Column="0" Classes="link" HorizontalAlignment="Left" Padding="0"
                            IsVisible="{Binding HasStoreUrl}"
                            ToolTip.Tip="Open the GOG store page"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenUrlCommand}"
                            CommandParameter="{Binding StoreUrl}">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding !HasStoreUrl}"/>

                    <Border Grid.Column="1" IsVisible="{Binding IsNew}" VerticalAlignment="Center" Margin="9,0,0,0"
                            Background="{Binding NewChipBg}" BorderBrush="{Binding NewChipBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusChip}" Padding="7,1"
                            ToolTip.Tip="New to your library since a recent scan. It clears when the item is fully backed up.">
                      <TextBlock Text="New" Foreground="{StaticResource AccentAmberSoft}"
                                 FontSize="{StaticResource FontEyebrow}" FontWeight="Bold" LetterSpacing="0.3"/>
                    </Border>

                    <Border Grid.Column="2" Classes="typebadge" BorderBrush="{Binding TypeBadgeBrush}" IsVisible="{Binding ShowTypeBadge}" VerticalAlignment="Center" Margin="9,0,0,0">
                      <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding TypeBadgeBrush}"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="Auto" MinWidth="64" CanUserSort="True"
                                    SortMemberPath="OwnerSortKey" CanUserResize="True">
              <DataGridTemplateColumn.Header>

                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="Owner" VerticalAlignment="Center" Classes.filteron="{Binding OwnerFilterActive}"/>
                  <Button Classes="filterarrow" Classes.filteron="{Binding OwnerFilterActive}" Click="OnOwnerFilterClick"
                          Background="Transparent" BorderThickness="0" Padding="3,2" Cursor="Hand" ToolTip.Tip="Filter by account">
                    <Path Fill="{StaticResource AccentAmber}" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Data="M 0,0 L 9,0 L 5.5,4 L 5.5,8.5 L 3.5,7 L 3.5,4 Z"/>
                  </Button>
                </StackPanel>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GameRowViewModel">
                  <ItemsControl ItemsSource="{Binding OwnerBadges}" VerticalAlignment="Center" Margin="8,0"
                                MinWidth="{Binding OwnerCellMinWidth}" HorizontalAlignment="Left"
                                ToolTip.Tip="{Binding OwnerNames}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="{Binding OwnerSpacing}"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccountBadge">

                        <Border Classes="acctdisc" Background="{Binding Fill}">
                          <TextBlock Text="{Binding Initials}" Foreground="{Binding Ink}"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Size" Binding="{Binding TotalSizeText}" Width="Auto" MinWidth="100" CanUserSort="True" SortMemberPath="TotalSizeBytes" CellStyleClasses="num"/>
            <DataGridTemplateColumn Width="Auto" MinWidth="96" CanUserSort="True" SortMemberPath="LocationText">
              <DataGridTemplateColumn.Header>
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="Storage" VerticalAlignment="Center" Classes.filteron="{Binding FolderFilterActive}"/>
                  <Button Classes="filterarrow" Classes.filteron="{Binding FolderFilterActive}" Click="OnFolderFilterClick"
                          Background="Transparent" BorderThickness="0" Padding="3,2" Cursor="Hand" ToolTip.Tip="Filter by storage">
                    <Path Fill="{StaticResource AccentAmber}" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Data="M 0,0 L 9,0 L 5.5,4 L 5.5,8.5 L 3.5,7 L 3.5,4 Z"/>
                  </Button>
                </StackPanel>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GameRowViewModel">
                  <TextBlock Text="{Binding LocationShort}" ToolTip.Tip="{Binding LocationText}" VerticalAlignment="Center"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Game" Binding="{Binding GameFileCount}" Width="Auto" MinWidth="78" CanUserSort="True" CellStyleClasses="num"/>

            <DataGridTemplateColumn Width="Auto" MinWidth="146" CanUserSort="True" SortMemberPath="ExtraFileCount">
              <DataGridTemplateColumn.Header>
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="Extras" VerticalAlignment="Center" Classes.filteron="{Binding ExtrasFilterActive}"/>
                  <Button Classes="filterarrow" Classes.filteron="{Binding ExtrasFilterActive}" Click="OnExtrasFilterClick"
                          Background="Transparent" BorderThickness="0" Padding="3,2" Cursor="Hand"
                          ToolTip.Tip="Filter by extras type - drives the same filter as the toolbar chips">
                    <Path Fill="{StaticResource AccentAmber}" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Data="M 0,0 L 9,0 L 5.5,4 L 5.5,8.5 L 3.5,7 L 3.5,4 Z"/>
                  </Button>
                </StackPanel>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:GameRowViewModel">
                  <ItemsControl ItemsSource="{Binding ExtraChips}" VerticalAlignment="Center" Margin="0,3">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" MaxWidth="112"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GameRowViewModel+ExtraChip">
                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,1,9,1" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" Classes.exdim="{Binding Dim}">
                          <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Count}" FontSize="{StaticResource FontEyebrow}" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Total" Binding="{Binding TotalFileCount}" Width="Auto" MinWidth="78" CanUserSort="True" CellStyleClasses="num"/>

          </DataGrid.Columns>
        </DataGrid>
        </Border>
        </DockPanel>
      </Border>

      <Panel Grid.Column="2">

        <Border Width="1" HorizontalAlignment="Left" Background="{StaticResource FlatEdge}"
                IsHitTestVisible="False"/>

        <Border Background="Transparent" Margin="0,61,0,0">
        <DockPanel>

        <StackPanel DockPanel.Dock="Bottom">

        <Border IsVisible="{Binding ShowScanPanel}"
                Background="{StaticResource SurfaceSection}" BorderBrush="{StaticResource StrokeAmberSoft}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="18,14"
                Margin="0,0,14,12">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">

              <TextBlock Grid.Column="0" Text="{Binding ScanPanelTitle}" Classes="eyebrow" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding CatalogCountText}" Foreground="White"
                         FontSize="{StaticResource FontRow}" FontFamily="{StaticResource MonoFont}"
                         VerticalAlignment="Center" Margin="0,0,14,0"/>
              <TextBlock Grid.Column="2" Text="{Binding CatalogPercentText}" Foreground="{StaticResource AccentAmber}"
                         FontSize="{StaticResource FontRow}" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar Classes="prominent" Height="8"
                         Value="{Binding CatalogProgress}" IsIndeterminate="{Binding CatalogIndeterminate}"
                         Foreground="{StaticResource AccentAmber}" Background="{StaticResource PlotRecess}"/>

          </StackPanel>
        </Border>

          <Grid x:Name="GuideActionRow" ColumnDefinitions="*,10,*" Margin="14,12,14,14">

          <Button Grid.Column="0" Classes="secondarybtn outline" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CheckForUpdatesCommand}"
                  IsVisible="{Binding ShowLibrarySecondary}"
                  Padding="10,9" ToolTip.Tip="Ask GOG what has changed for the selected games">
            <TextBlock Text="{Binding LibraryRescanLabel}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Button>

          <Button x:Name="GuidePrimaryAction" Grid.Column="2" Classes="primary"
                  Classes.dimmed="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryDimmed}"
                  Classes.neutral="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryNeutral}" Classes.resume="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryResume}"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryCommand}" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryEnabled}" Padding="10,9"
                  ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryLabel}">
            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BarPrimaryLabel}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Button>
        </Grid>

        </StackPanel>

        <Border DockPanel.Dock="Bottom" Height="1" Margin="0,0,14,0" Background="{StaticResource StrokeSubtle}"/>

        <Panel>

        <StackPanel IsVisible="{Binding !DetailHasSelection}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Margin="24">
          <TextBlock Text="No game selected" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Pick a game in the library to see its files, sizes and serial keys."
                     Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"/>
        </StackPanel>
        <ScrollViewer IsVisible="{Binding DetailHasSelection}">
          <StackPanel>

            <Border MaxWidth="440" HorizontalAlignment="Stretch" IsVisible="{Binding HasDetailArt}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="{StaticResource StrokeAltColor}" Offset="0"/><GradientStop Color="{StaticResource SurfacePanelAltColor}" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Image Source="{Binding DetailLogoBitmap}"/>
              </Viewbox>
            </Border>

            <Border Padding="16,12,16,10">
              <StackPanel>
                <TextBlock Text="{Binding DetailTitle}" Foreground="White" FontSize="{StaticResource FontTitle}" FontWeight="Bold" TextWrapping="Wrap"/>

                <Border Height="4" CornerRadius="2" Background="{StaticResource AmberRuleFade}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>

            <StackPanel Margin="16" Spacing="14">

              <Grid ColumnDefinitions="Auto,*">

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                  <StackPanel Margin="0,0,0,9">
                    <TextBlock Text="DETAILS" Foreground="White" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"/>
                    <Border Height="1" Background="{StaticResource FlatEdge}" Margin="0,4,8,0" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                  <Grid ColumnDefinitions="76,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailStatus}" Foreground="White" FontSize="{StaticResource FontBody}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Storage" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontBody}" Margin="0,7,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailDrive}" Foreground="White" FontFamily="Consolas,monospace" FontSize="{StaticResource FontBody}" Margin="0,7,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontBody}" Margin="0,7,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailSize}" Foreground="White" FontFamily="Consolas,monospace" FontSize="{StaticResource FontBody}" Margin="0,7,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Added" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontBody}" Margin="0,7,0,0" IsVisible="{Binding DetailHasAcquired}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailAcquired}" Foreground="White" FontSize="{StaticResource FontBody}" Margin="0,7,0,0" IsVisible="{Binding DetailHasAcquired}"/>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="40,0,0,0" HorizontalAlignment="Left"
                            VerticalAlignment="Top" IsVisible="{Binding DetailHasRatings}">
                  <StackPanel Margin="0,0,0,9">
                    <TextBlock Text="RATINGS" Foreground="White" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"/>
                    <Border Height="1" Background="{StaticResource FlatEdge}" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding DetailRatings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RatingEntry">
                        <Grid ColumnDefinitions="52,Auto" Margin="0,0,0,5">

                          <TextBlock Grid.Column="0" Text="{Binding Board}" Foreground="{StaticResource InkMuted}"
                                     FontSize="{StaticResource FontBody}" FontWeight="Bold" VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Tooltip}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Age}" IsVisible="{Binding HasRating}" Margin="6,0,0,0"
                                     Foreground="White" FontSize="{StaticResource FontBody}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="NA" IsVisible="{Binding !HasRating}" Margin="6,0,0,0"
                                     Foreground="White" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,-6,0,0" IsVisible="{Binding DetailHasLanguages}">
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="LANGUAGES" Foreground="White" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"/>
                  <Border Height="1" Background="{StaticResource FlatEdge}" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <TextBlock Text="{Binding DetailLanguages}" Foreground="White" FontSize="{StaticResource FontBody}" TextWrapping="Wrap"/>
              </StackPanel>

              <TextBlock IsVisible="{Binding DetailShowOwners}" TextWrapping="Wrap" FontSize="{StaticResource FontBody}">
                <Run Text="Owned By: " Foreground="{StaticResource AccentAmberSoft}" FontWeight="SemiBold"/><Run Text="{Binding DetailOwners}" Foreground="{StaticResource White}"/>
              </TextBlock>

              <Grid ColumnDefinitions="90,*" IsVisible="{Binding DetailHasSerial}">
                <TextBlock Grid.Column="0" Text="Serial key" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"/>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DetailSerials}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SerialEntry">

                      <StackPanel Spacing="1" Margin="0,0,0,7">
                        <TextBlock Text="{Binding Name}" IsVisible="{Binding HasName}" FontWeight="Bold"
                                   Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
                        <SelectableTextBlock Text="{Binding Key}" Foreground="{StaticResource AccentAmber}"
                                             FontFamily="Consolas,monospace" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                             ToolTip.Tip="Select to copy"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>

              <Button Content="Open on GOG ↗" Classes="ghost" IsVisible="{Binding DetailHasStoreUrl}"
                      Command="{Binding OpenStorePageCommand}"/>

              <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding HasGameFiles}" Margin="0,14,0,4">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Delete downloaded files" Foreground="{StaticResource ErrorRedBright}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.DeleteSectionCommand}"
                              CommandParameter="games"/>
                  </ContextMenu>
                </Grid.ContextMenu>
                <Button Grid.Column="0" Classes="filedl" Padding="0" Width="20" Height="20" Margin="0,0,7,0"
                        IsVisible="{Binding GameFilesShowDownload}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DownloadSectionCommand}"
                        CommandParameter="game" ToolTip.Tip="Download all game files, in order">
                  <TextBlock Text="↓" Foreground="{StaticResource AccentAmber}" FontWeight="Bold" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Center"/>
                </Button>
                <TextBlock Grid.Column="0" Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold" FontSize="{StaticResource FontCaption}" Width="20" Height="20" Margin="0,0,7,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding GameFilesAllDone}" ToolTip.Tip="All game files backed up"/>
                <TextBlock Grid.Column="1" Text="(All) Game Files" Foreground="White" FontWeight="Bold" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="2" Background="{StaticResource AmberRuleFade}" Margin="0,4,0,0"/>
              </Grid>

              <ItemsControl ItemsSource="{Binding DetailGameFiles}" IsVisible="{Binding HasGameFiles}" Margin="14,-10,0,0" ItemTemplate="{StaticResource DetailFileRowTemplate}"/>

              <StackPanel Spacing="8" IsVisible="{Binding HasOutOfScopeInstallers}" Margin="0,14,0,4">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Column="0" Text="Game Files" Foreground="{StaticResource InkMuted}" FontWeight="Bold" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Classes="secondarybtn" Padding="10,4"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}" CommandParameter="Settings"
                          ToolTip.Tip="Platforms and languages are chosen in Settings" VerticalAlignment="Center">
                    <TextBlock Text="Change in Settings" FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold"/>
                  </Button>
                  <Border Grid.Row="1" Grid.ColumnSpan="2" Height="2" Background="{StaticResource NeutralRuleFade}" Margin="0,4,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0">
                  <TextBlock Text="Out of scope installers" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                  <ItemsControl ItemsSource="{Binding DetailOutOfScopeOs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetailFileRow">
                        <Border Classes="osbadge" BorderBrush="{Binding OsBadgeBrush}"><TextBlock Text="{Binding OsBadge}" Foreground="{Binding OsBadgeBrush}"/></Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding HasExtraFiles}" Margin="0,8,0,4">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Delete downloaded files" Foreground="{StaticResource ErrorRedBright}"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.DeleteSectionCommand}"
                              CommandParameter="extras"/>
                  </ContextMenu>
                </Grid.ContextMenu>
                <Button Grid.Column="0" Classes="filedl" Padding="0" Width="20" Height="20" Margin="0,0,7,0"
                        IsVisible="{Binding ExtrasShowDownload}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DownloadSectionCommand}"
                        CommandParameter="extras" ToolTip.Tip="Download all extras, in order">
                  <TextBlock Text="↓" Foreground="{StaticResource AccentAmber}" FontWeight="Bold" FontSize="{StaticResource FontCaption}" HorizontalAlignment="Center"/>
                </Button>
                <TextBlock Grid.Column="0" Text="✓" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold" FontSize="{StaticResource FontCaption}" Width="20" Height="20" Margin="0,0,7,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ExtrasAllDone}" ToolTip.Tip="All extras backed up"/>
                <TextBlock Grid.Column="1" Text="(All) Extras" Foreground="White" FontWeight="Bold" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="2" Background="{StaticResource AmberRuleFade}" Margin="0,4,0,0"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding DetailExtraFiles}" IsVisible="{Binding HasExtraFiles}" Margin="14,-10,0,0" ItemTemplate="{StaticResource DetailFileRowTemplate}"/>

              <StackPanel Spacing="8" IsVisible="{Binding HasOutOfScopeOnDisk}" Margin="0,8,0,4">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                  <Button Grid.Column="0" Classes="secondarybtn" Padding="8,3"
                          Command="{Binding ToggleOutOfScopeOnDiskCommand}" ToolTip.Tip="Downloaded before the scope changed. Delete per file, or leave them.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="▸" IsVisible="{Binding !OutOfScopeOnDiskExpanded}" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"/>
                      <TextBlock Text="▾" IsVisible="{Binding OutOfScopeOnDiskExpanded}" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"/>
                      <TextBlock Text="{Binding OutOfScopeOnDiskHeader}" Foreground="{StaticResource InkMuted}" FontWeight="Bold" FontSize="{StaticResource FontCaption}"/>
                    </StackPanel>
                  </Button>
                  <Border Grid.Row="1" Grid.ColumnSpan="2" Height="2" Background="{StaticResource NeutralRuleFade}" Margin="0,4,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding DetailOutOfScopeOnDisk}" IsVisible="{Binding OutOfScopeOnDiskExpanded}" Margin="14,-6,0,0" ItemTemplate="{StaticResource DetailFileRowTemplate}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        </Panel>
        </DockPanel>
      </Border>
      </Panel>
    </Grid>
    </DockPanel>
  </Panel>
</UserControl>
