
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Grog.App.ViewModels"
             xmlns:ctl="using:Grog.App.Controls"
             x:Class="Grog.App.Views.Pages.AboutPage"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Background="Transparent">

    <Border Classes="barecard" Margin="14,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center"
            MinHeight="{Binding $parent[ScrollViewer].Viewport.Height}"
            Background="Transparent">
      <Panel>

      <StackPanel Spacing="0" VerticalAlignment="Center">

        <StackPanel Classes="sbody" Spacing="12" MaxWidth="820" HorizontalAlignment="Center">

      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Grid.Column="0">
          <TextBlock FontSize="59" FontWeight="Bold" Foreground="{StaticResource InkPrimary}"
                     LineHeight="62">G<Run Foreground="{StaticResource AccentAmber}">R</Run>OG</TextBlock>
          <Border Height="5" CornerRadius="3" Background="{StaticResource AccentAmber}" Width="150"
                  HorizontalAlignment="Left" Margin="3,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                    RenderTransform="translate(0px, 7px)">
          <TextBlock Text="{Binding AppVersionText}" Foreground="{StaticResource InkDim}"
                     FontSize="16.5" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding AppCopyrightText}" Foreground="{StaticResource InkDim}"
                     FontSize="16.5" HorizontalAlignment="Right" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>

      <Border Height="0" Margin="0,4,0,4"/>

      <TextBlock Text="A cross-platform tool for backing up your DRM-free GOG library."
                 Foreground="{StaticResource White}" FontSize="16.5" TextWrapping="Wrap"/>
      <TextBlock Text="Grog is not affiliated with, or endorsed by, GOG.com or its owners."
                 Foreground="{StaticResource InkFaint}" FontSize="16.5" TextWrapping="Wrap" Margin="0,2,0,0"/>

      <Grid ColumnDefinitions="Auto,*" Margin="0,20,0,0">
        <TextBlock Grid.Column="0" Text="ACKNOWLEDGEMENTS" Classes="eyebrow abouteyebrow"/>
        <Border Grid.Column="1" Height="1" Background="{StaticResource AmberRuleFade}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>

      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <Button Grid.Row="0" Grid.Column="0" Classes="acklink" Command="{Binding OpenUrlCommand}"
                CommandParameter="https://www.gog.com" ToolTip.Tip="gog.com">
          <TextBlock Classes="ackname acklinktext" Text="GOG.com"/>
        </Button>
        <TextBlock Grid.Row="0" Grid.Column="1" Classes="ackrole" Text="the DRM-free library this exists to protect"/>

        <Button Grid.Row="1" Grid.Column="0" Classes="acklink" Command="{Binding OpenUrlCommand}"
                CommandParameter="https://github.com/Yepoleb/gogapidocs" ToolTip.Tip="github.com/Yepoleb/gogapidocs">
          <TextBlock Classes="ackname acklinktext" Text="Unofficial GOG API docs"/>
        </Button>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <Button Classes="acklink" Command="{Binding OpenUrlCommand}"
                  CommandParameter="https://github.com/Yepoleb" ToolTip.Tip="github.com/Yepoleb">
            <TextBlock Classes="ackrole personlink" Text="Yepoleb"/>
          </Button>
          <TextBlock Classes="ackrole" Text=" - the API reference"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
          <Button Classes="acklink" Command="{Binding OpenUrlCommand}"
                  CommandParameter="https://github.com/Kalanyr/gogrepoc" ToolTip.Tip="github.com/Kalanyr/gogrepoc">
            <TextBlock Classes="ackname acklinktext" Text="gogrepoc" Margin="0,0,5,5"/>
          </Button>
          <TextBlock Classes="ackname" Text="&amp;" Margin="0,0,5,5"/>
          <Button Classes="acklink" Command="{Binding OpenUrlCommand}"
                  CommandParameter="https://github.com/Sude-/lgogdownloader" ToolTip.Tip="github.com/Sude-/lgogdownloader">
            <TextBlock Classes="ackname acklinktext" Text="lgogdownloader"/>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="ackrole" Text="prior art"/>

        <Button Grid.Row="6" Grid.Column="0" Classes="acklink" Command="{Binding OpenUrlCommand}"
                CommandParameter="https://getlibation.com" ToolTip.Tip="getlibation.com">
          <TextBlock Classes="ackname acklinktext" Text="Libation"/>
        </Button>
        <StackPanel Grid.Row="6" Grid.Column="1">
          <StackPanel Orientation="Horizontal">
            <Button Classes="acklink" Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/rmcrackan" ToolTip.Tip="github.com/rmcrackan">
              <TextBlock Classes="ackrole personlink" Text="rmcrackan"/>
            </Button>
            <TextBlock Classes="ackrole" Text=", "/>
            <Button Classes="acklink" Command="{Binding OpenUrlCommand}"
                    CommandParameter="https://github.com/Mbucari" ToolTip.Tip="github.com/Mbucari">
              <TextBlock Classes="ackrole personlink" Text="Mbucari"/>
            </Button>
            <TextBlock Classes="ackrole" Text=" and the other contributors"/>
          </StackPanel>
          <TextBlock Classes="ackrole" Text="for the grid with artwork idea and inspiration for the name"/>
        </StackPanel>

        <Button Grid.Row="3" Grid.Column="0" Classes="acklink" Command="{Binding OpenUrlCommand}"
                CommandParameter="https://avaloniaui.net" ToolTip.Tip="avaloniaui.net - MIT">
          <TextBlock Classes="ackname acklinktext" Text="Avalonia"/>
        </Button>
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="ackrole" Text="the cross-platform UI framework"/>

        <Button Grid.Row="4" Grid.Column="0" Classes="acklink" Command="{Binding OpenUrlCommand}"
                CommandParameter="https://pictogrammers.com/library/mdi/" ToolTip.Tip="pictogrammers.com - Apache 2.0">
          <TextBlock Classes="ackname acklinktext" Text="Material Design Icons"/>
        </Button>
        <TextBlock Grid.Row="4" Grid.Column="1" Classes="ackrole" Text="the content-type glyphs on chips and squares"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
          <Button Classes="acklink" Command="{Binding OpenUrlCommand}"
                  CommandParameter="https://rsms.me/inter/" ToolTip.Tip="rsms.me/inter - SIL OFL 1.1">
            <TextBlock Classes="ackname acklinktext" Text="Inter" Margin="0,0,5,5"/>
          </Button>
          <TextBlock Classes="ackname" Text="&amp;" Margin="0,0,5,5"/>
          <Button Classes="acklink" Command="{Binding OpenUrlCommand}"
                  CommandParameter="https://github.com/microsoft/cascadia-code" ToolTip.Tip="github.com/microsoft/cascadia-code - SIL OFL 1.1">
            <TextBlock Classes="ackname acklinktext" Text="Cascadia Mono"/>
          </Button>
        </StackPanel>
        <TextBlock Grid.Row="5" Grid.Column="1" Classes="ackrole" Text="typefaces"/>
      </Grid>

      <Grid ColumnDefinitions="Auto,*" Margin="0,20,0,0">
        <TextBlock Grid.Column="0" Text="BUILT WITH CLAUDE" Classes="eyebrow abouteyebrow"/>
        <Border Grid.Column="1" Height="1" Background="{StaticResource AmberRuleFade}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock Foreground="{StaticResource InkDim}" FontSize="16.5" TextWrapping="Wrap">
        <Run Text="Grog was co-developed with "/><InlineUIContainer>

          <Button Classes="acklink" Padding="0" Background="Transparent" BorderThickness="0"
                  RenderTransform="translate(0px, 4px)"
                  Command="{Binding OpenUrlCommand}" CommandParameter="https://claude.ai" ToolTip.Tip="claude.ai">
            <TextBlock Classes="acklinktext" FontSize="16.5" Text="Claude Cowork"/>
          </Button></InlineUIContainer><Run Text=". Architecture, interface design and a significant portion of the implementation was a result of many long back-and-forth sessions rather than from a spec."/>
      </TextBlock>

      <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,0">

        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0" TextWrapping="Wrap"
                   Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}"
                   Text="Grog is free software: use it, share it, and improve it under the GNU GPL v3."/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button Classes="secondarybtn outline" Padding="12,8"
                  Command="{Binding OpenLicenseFileCommand}"
                  ToolTip.Tip="The GPL-3.0 text this build ships with">
            <TextBlock Text="View License"/>
          </Button>
          <Button Classes="secondarybtn outline" Padding="12,8"
                  Command="{Binding OpenThirdPartyNoticesCommand}"
                  ToolTip.Tip="The full license texts for the open-source components Grog ships (MDI, Inter, Cascadia Mono, Avalonia and friends)">
            <TextBlock Text="Third-Party Notices"/>
          </Button>
          <Button Classes="secondarybtn outline" Padding="12,8"
                  Command="{Binding OpenLogFileCommand}"
                  ToolTip.Tip="Open grog.log - the full history, kept across restarts">
            <TextBlock Text="Open Log File"/>
          </Button>
        </StackPanel>
      </Grid>
        </StackPanel>
      </StackPanel>
      </Panel>
    </Border>
  </ScrollViewer>
</UserControl>
