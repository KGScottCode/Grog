
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Grog.App.ViewModels"
             xmlns:ctl="using:Grog.App.Controls"
             x:Class="Grog.App.Views.Pages.StoragePage"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer Background="Transparent" VerticalScrollBarVisibility="Auto"
                DataContext="{Binding Storage}" x:DataType="vm:StorageViewModel">

  <Grid Background="Transparent"
        Height="{Binding $parent[ScrollViewer].Viewport.Height}">

  <Border Margin="0" Background="Transparent" BorderThickness="0">
  <Grid RowDefinitions="*">

  <DockPanel Grid.Row="0" Margin="14,12,14,10" LastChildFill="True">

      <Border DockPanel.Dock="Top" IsVisible="{Binding HasReorgActive}" Margin="0,14,0,0" Padding="14,9"
              Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource AccentAmberSoft}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusCard}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="MOVING" Classes="eyebrow" Foreground="{StaticResource AccentAmber}" VerticalAlignment="Center"/>
          <TextBlock Text="The cards below still show where files are now; they switch over when the move finishes."
                     Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}"
                     TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border x:Name="OtherStorageSection" DockPanel.Dock="Bottom" IsVisible="{Binding HasOtherStorage}" Margin="0,10,0,0" Padding="14,9"
              Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource SurfaceStroke}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusCard}">
        <StackPanel Spacing="4">

          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <Button Grid.Column="0" Classes="linky" Padding="0" Background="Transparent" Content="{Binding OtherStorageCaret}" Foreground="{StaticResource InkDim}"
                    FontSize="{StaticResource FontCaption}" ToolTip.Tip="{Binding OtherStorageToggleTip}" Command="{Binding ToggleOtherStorageSectionCommand}"/>
            <TextBlock Grid.Column="1" Text="OTHER STORAGE" Classes="eyebrow" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding OtherStorageSummary}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}"
                       VerticalAlignment="Center" IsVisible="{Binding !ShowOtherStorageSection}" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding OtherStorage}" IsVisible="{Binding ShowOtherStorageSection}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StorageViewModel+OtherStorageRow">
                <StackPanel>
                  <Grid ColumnDefinitions="22,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,3">
                    <Button Grid.Column="0" Classes="linky" Padding="0" Background="Transparent" Content="{Binding Caret}" Foreground="{StaticResource InkDim}"
                            Command="{Binding $parent[ItemsControl].((vm:StorageViewModel)DataContext).ToggleOtherExpandedCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Show what is on this storage"/>
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Label}" Foreground="White" FontSize="{StaticResource FontRow}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <Button Classes="linky" Padding="2,0" Background="Transparent" Content="✎" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"
                              VerticalAlignment="Center" ToolTip.Tip="Rename"
                              Command="{Binding $parent[ItemsControl].((vm:StorageViewModel)DataContext).RequestRenameOtherCommand}" CommandParameter="{Binding}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Path}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Summary}" Foreground="White" FontSize="{StaticResource FontCaption}" FontFeatures="+tnum" VerticalAlignment="Center"/>
                    <Button Grid.Column="5" Classes="sortpill" Content="{Binding SecondaryActionLabel}" FontSize="{StaticResource FontCaption}" Padding="11,5" IsEnabled="{Binding IsConnected}"
                            ToolTip.Tip="Give this drive the Secondary slot. Files never move; the queue re-plans."
                            Command="{Binding $parent[ItemsControl].((vm:StorageViewModel)DataContext).UseAsSecondaryCommand}" CommandParameter="{Binding}"/>
                    <Button Grid.Column="6" Classes="sortpill" Content="{Binding PrimaryActionLabel}" FontSize="{StaticResource FontCaption}" Padding="11,5" IsEnabled="{Binding IsConnected}"
                            ToolTip.Tip="Give this drive the Primary slot; the current Primary becomes Other storage. Files never move."
                            Command="{Binding $parent[ItemsControl].((vm:StorageViewModel)DataContext).SwapWithPrimaryCommand}" CommandParameter="{Binding}"/>
                    <Button Grid.Column="7" Classes="sortpill danger" Content="Forget" FontSize="{StaticResource FontCaption}" Padding="11,5"
                            ToolTip.Tip="Stop tracking this drive. Its files count as not backed up and return to the queue; nothing on the drive is touched."
                            Command="{Binding $parent[ItemsControl].((vm:StorageViewModel)DataContext).RequestForgetDetachedCommand}" CommandParameter="{Binding}"/>
                  </Grid>

                  <Border IsVisible="{Binding IsExpanded}" Margin="22,0,0,6" Padding="10,6" Background="{StaticResource SurfaceBg}"
                          BorderBrush="{StaticResource FlatEdge}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding GamesHeader}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold"/>
                      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Games}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StorageViewModel+OtherStorageGame">
                              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource InkBright}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" FontFeatures="+tnum" Margin="12,0,0,0"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Top" IsVisible="{Binding ShowSystemDriveHint}" Margin="0,14,0,0" Padding="14,9"
              Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource AccentAmberSoft}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusCard}">

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Not enough room on primary storage" Foreground="{StaticResource AccentAmber}"
                       FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SystemDriveHintText}"
                       Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}"
                       TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="primary" Content="Add second storage" FontSize="{StaticResource FontCaption}" Padding="12,6"
                  VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding AddLocationCommand}" IsEnabled="{Binding CanAddSecondary}"
                  ToolTip.Tip="Pick a folder to use as secondary storage. Files that do not fit on the primary spill there automatically."/>
          <Button Grid.Column="2" Classes="linky" Content="✕" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"
                  VerticalAlignment="Center" Command="{Binding DismissSystemDriveHintCommand}"/>
        </Grid>
      </Border>

      <Grid IsVisible="{Binding HasLocation}" MinHeight="240" Margin="0,57,0,0"
            ColumnDefinitions="*,28,*" RowDefinitions="Auto,Auto,Auto,*">
        <Grid.DataTemplates>

          <DataTemplate x:DataType="vm:BackupLocationRow">

            <Button Classes="devicecard" Classes.problem="{Binding IsProblem}" Classes.disconnected="{Binding IsDisconnected}" Classes.reattached="{Binding JustReattached}" Padding="14,12" VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Tag="{Binding RootId}"
                    Focusable="False">

              <Grid RowDefinitions="Auto,*">

              <Grid Grid.Row="1" VerticalAlignment="Bottom" ColumnDefinitions="Auto,*">

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ClipToBounds="True">
                  <Button Classes="sortpill" Classes.act="{Binding Removable}" Content="{Binding RemovableButtonText}"
                          FontSize="{StaticResource FontCaption}" Padding="11,5" ToolTip.Tip="{Binding RemovableTip}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ToggleRemovableCommand}" CommandParameter="{Binding}"/>
                  <Button Classes="sortpill" Content="Make Primary" FontSize="{StaticResource FontCaption}" Padding="11,5"
                          IsVisible="{Binding !IsPrimary}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.RequestMakePrimaryCommand}" CommandParameter="{Binding}"/>
                  <Button Classes="sortpill" Content="Mark as Lost" FontSize="{StaticResource FontCaption}" Padding="11,5"
                          IsVisible="{Binding !IsOnline}" Foreground="{StaticResource WarnOrange}"
                          ToolTip.Tip="This storage is gone for good - forget its files (they return to your backup queue)."
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.RequestLostDeviceCommand}" CommandParameter="{Binding}"/>

                  <Button Classes="sortpill danger" Content="{Binding DetachLabel}" FontSize="{StaticResource FontCaption}" Padding="11,5"
                          ToolTip.Tip="Take this storage out of Grog: keep its files counted (Detach), stop tracking them (Forget), move them first, or erase them (type DELETE)."
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.RequestDeleteDeviceCommand}" CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="0" Spacing="7" VerticalAlignment="Top">
                <Grid ColumnDefinitions="Auto,*,Auto">

                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusWord}" Foreground="{Binding StateBrush}" FontSize="{StaticResource FontRow}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VerifyText}" IsVisible="{Binding IsVerifying}" Foreground="{StaticResource AccentAmber}"
                               FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" FontFeatures="+tnum" VerticalAlignment="Center"/>
                  </StackPanel>

                  <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="White"
                             FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace"
                             TextTrimming="LeadingCharacterEllipsis" VerticalAlignment="Center"
                             Margin="10,0,12,0" ToolTip.Tip="{Binding Path}"/>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">

                    <Button x:Name="GuideChangeFolder" Classes="sortpill" Content="Change Folder"
                            FontSize="{StaticResource FontCaption}" Padding="12,6"
                            ToolTip.Tip="Pick a different folder for this slot"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.ChangeFolderCommand}"
                            CommandParameter="{Binding}"/>

                    <Button Classes="sortpill act" Content="Open Folder" FontSize="{StaticResource FontCaption}" Padding="12,6"
                            ToolTip.Tip="Open this folder in your file manager"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.OpenFolderCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </Grid>

                <Border IsVisible="{Binding IsDisconnected}" Background="{StaticResource SurfaceRaised}"
                        BorderBrush="{StaticResource WarnOrange}" BorderThickness="3,0,0,0" CornerRadius="{StaticResource RadiusChip}"
                        Padding="9,6" Margin="0,1,0,1">

                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="⏏" Foreground="{StaticResource WarnOrange}" FontSize="{StaticResource FontCaption}"
                               VerticalAlignment="Top" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisconnectedNotice}" Foreground="{StaticResource InkDim}"
                               FontSize="{StaticResource FontEyebrow}" TextWrapping="Wrap"/>
                  </Grid>
                </Border>

                <StackPanel Spacing="5" Margin="0,3,0,0">

                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="BACKED UP HERE" Foreground="White" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Height="1" Background="{StaticResource NeutralRuleFade}" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding UsageLine}" Foreground="White" FontSize="{StaticResource FontBody}" VerticalAlignment="Center"/>
                  </Grid>

                  <Border Height="10" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{StaticResource PlotRecess}"
                          BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1">
                    <Grid IsVisible="{Binding HasComposition}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Comp0}"/>
                        <ColumnDefinition Width="{Binding Comp1}"/>
                        <ColumnDefinition Width="{Binding Comp2}"/>
                        <ColumnDefinition Width="{Binding Comp3}"/>
                        <ColumnDefinition Width="{Binding Comp4}"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Background="{Binding CompBrush0}"/>
                      <Border Grid.Column="1" Background="{Binding CompBrush1}"/>
                      <Border Grid.Column="2" Background="{Binding CompBrush2}"/>
                      <Border Grid.Column="3" Background="{Binding CompBrush3}"/>
                      <Border Grid.Column="4" Background="{Binding CompBrush4}"/>
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Composition}" IsVisible="{Binding HasComposition}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ExtraTypeSegment">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,2">
                          <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Name}" Foreground="White" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Nothing backed up here yet" Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}"
                             IsVisible="{Binding NothingBackedUpHere}"/>

                  <StackPanel Spacing="5" Margin="0,10,0,0" IsVisible="{Binding ShowCapacityBar}">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="DRIVE SPACE" Foreground="{StaticResource InkDim}"
                                 FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold" LetterSpacing="1" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Height="1" Background="{StaticResource NeutralRuleFade}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="10" CornerRadius="{StaticResource RadiusChip}" ClipToBounds="True" Background="{StaticResource PlotRecess}"
                            BorderBrush="{StaticResource SurfaceStroke}" BorderThickness="1" ToolTip.Tip="{Binding BarToolTip}">
                      <Grid>

                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding CapGrogCol}"/>
                          <ColumnDefinition Width="{Binding CapQueuedCol}"/>
                          <ColumnDefinition Width="{Binding CapOtherCol}"/>
                          <ColumnDefinition Width="{Binding CapFreeCol}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource AccentAmber}"/>
                        <Border Grid.Column="1" Background="{Binding QueuedSegmentBrush}"/>
                        <Border Grid.Column="2" Background="{StaticResource InkFaint}"/>
                        <Border Grid.Column="3" Background="Transparent"/>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding CapacityCaption}" Foreground="{StaticResource InkDim}"
                               FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"/>

                    <Border IsVisible="{Binding HasUnplaceableQueue}" Margin="0,2,0,10" Padding="9,6"
                            Background="{StaticResource SurfaceErrorSoft}" BorderBrush="{StaticResource StrokeErrorSoft}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusChip}">
                      <TextBlock Text="{Binding UnplaceableLine}" Foreground="{StaticResource ErrorRedBright}"
                                 FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>

          <DataTemplate x:DataType="vm:InventoryGroupRow">

            <Border Classes="invgroup" Classes.selrow="{Binding IsSelected}" Tag="{Binding}">
              <Border.ContextMenu>

                <ContextMenu>
                  <MenuItem Header="Open containing folder"
                            Command="{Binding OpenGameFolderCommand}"
                            CommandParameter="{Binding}"/>
                  <MenuItem Header="{Binding CopyPathsLabel}"
                            Command="{Binding CopyGamePathsCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="Rescan &amp; verify"
                            IsVisible="{Binding CanVerify}"
                            Command="{Binding VerifyGameCommand}"
                            CommandParameter="{Binding}"/>

                  <MenuItem Header="{Binding RedownloadAllLabel}"
                            Command="{Binding RedownloadGameCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator IsVisible="{Binding ShowPlacementBlock}"/>
                  <MenuItem Header="Queue missing files (as filtered)"
                            IsVisible="{Binding !IsComplete}"
                            Command="{Binding QueueRemainingFilteredCommand}"
                            CommandParameter="{Binding}"/>
                  <MenuItem Header="Queue missing files (all types)"
                            IsVisible="{Binding !IsComplete}"
                            Command="{Binding QueueRemainingAllCommand}"
                            CommandParameter="{Binding}"/>
                  <MenuItem Header="Move remaining to top of queue"
                            IsVisible="{Binding !IsComplete}"
                            Command="{Binding MoveRemainingTopCommand}"
                            CommandParameter="{Binding}"/>

                  <MenuItem Header="{Binding ConsolidateLabel}"
                            IsVisible="{Binding HasElsewhere}"
                            IsEnabled="{Binding ConsolidateCanRun}"
                            ToolTip.Tip="{Binding ConsolidateTip}"
                            Command="{Binding ConsolidateCommand}"
                            CommandParameter="{Binding}"/>

                  <Separator IsVisible="{Binding CanVerify}"/>
                  <MenuItem Header="{Binding DeleteAllLabel}" Foreground="{StaticResource ErrorRedBright}"
                            IsVisible="{Binding CanVerify}"
                            Command="{Binding DeleteGameCommand}"
                            CommandParameter="{Binding}"/>
                </ContextMenu>
              </Border.ContextMenu>
              <Grid ColumnDefinitions="32,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Caret}" Tag="caret" Classes="caret"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Border Grid.Column="1" CornerRadius="{StaticResource RadiusCard}" Padding="9,2" Margin="0,0,9,0"
                        Background="{Binding CompletenessBg}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding CompletenessText}" Foreground="{Binding CompletenessBrush}"
                               FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CountText}" Foreground="White"
                               FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" FontFeatures="+tnum"/>
                  </StackPanel>
                </Border>
                <TextBlock Grid.Column="2" Classes="rowink" Text="{Binding Title}" MinWidth="70"
                           FontSize="{StaticResource FontBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Classes="rowink" Text="{Binding SizeText}"
                           FontSize="{StaticResource FontCaption}" FontFamily="Consolas,monospace" VerticalAlignment="Center" FontFeatures="+tnum" Margin="12,0,0,0"/>
              </Grid>
            </Border>
          </DataTemplate>

          <DataTemplate x:DataType="vm:InventoryRow">
            <Border Classes="invfile" Classes.selrow="{Binding IsSelected}" Tag="{Binding}"
                    IsVisible="{Binding Owner.IsExpanded, FallbackValue=True}">

              <Border.ContextMenu>
                <ContextMenu>

                  <MenuItem Header="Open containing folder"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenContainingFolderCommand}"
                            CommandParameter="{Binding}"/>
                  <MenuItem Header="Copy full path"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyFilePathCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="Rescan &amp; verify"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VerifyInventoryFileCommand}"
                            CommandParameter="{Binding}"/>
                  <MenuItem Header="Re-download"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RedownloadInventoryFileCommand}"
                            CommandParameter="{Binding}"/>
                  <Separator/>
                  <MenuItem Header="Delete downloaded file" Foreground="{StaticResource ErrorRedBright}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Library.DeleteInventoryFileCommand}"
                            CommandParameter="{Binding}"/>
                </ContextMenu>
              </Border.ContextMenu>

              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="rowink" Text="{Binding FileName}" FontSize="{StaticResource FontBody}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Classes="typechip" Background="{Binding ExtraTypeFill}" BorderBrush="{Binding ExtraTypeBorder}" Margin="10,0,0,0" IsVisible="{Binding IsExtra}" ToolTip.Tip="{Binding TypeLabel}">
                  <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding ExtraTypeText}"/>
                </Border>
                <TextBlock Grid.Column="2" Classes="rowink" Text="{Binding SizeText}"
                           FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontFamily="Consolas,monospace" FontFeatures="+tnum" Margin="12,0,0,0"/>
              </Grid>
            </Border>
          </DataTemplate>
        </Grid.DataTemplates>
        <Grid.Styles>

                            <Style Selector="Border.invfile"><Setter Property="Background" Value="Transparent"/></Style>

          <Style Selector="Border.invgroup"><Setter Property="Background" Value="{Binding RowTint, DataType=vm:InventoryGroupRow}"/></Style>

          <Style Selector="Border.invgroup, Border.invfile"><Setter Property="BorderBrush" Value="{StaticResource FlatRowLine}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
          <Style Selector="Border.invgroup"><Setter Property="Padding" Value="10,9"/></Style>
          <Style Selector="Border.invfile"><Setter Property="Padding" Value="40,8,12,8"/></Style>

          <Style Selector="TextBlock.rowink"><Setter Property="Foreground" Value="White"/></Style>
          <Style Selector="Border.selrow TextBlock.rowink"><Setter Property="Foreground" Value="{StaticResource AccentAmber}"/></Style>
          <Style Selector="Border.invfile.selrow"><Setter Property="Background" Value="{StaticResource RowHoverFill}"/></Style>

          <Style Selector="TextBlock.caret">
            <Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
            <Setter Property="RenderTransform" Value="scale(1.75)"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
          </Style>

          <Style Selector="Button.sortpill TextBlock.mlbl"><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
          <Style Selector="Button.sortpill TextBlock.marw"><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

          <Style Selector="TextBlock.movetag"><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="LetterSpacing" Value="0.6"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        </Grid.Styles>

        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Classes="dividercol"
                      ResizeDirection="Columns" HorizontalAlignment="Stretch" ZIndex="5"/>

        <Border x:Name="GuidePrimaryFolder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Classes="scard" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" VerticalAlignment="Stretch"
                Classes.problem="{Binding PrimaryIsProblem}"
                Classes.disconnected="{Binding PrimaryIsDisconnected}"
                Classes.reattached="{Binding PrimaryJustReattached}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="shead">

              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0" Classes="sgh" Text="PRIMARY STORAGE"/>

                <ContentControl Grid.Column="1" Content="{Binding PrimaryLocation}" VerticalAlignment="Center">
                  <ContentControl.DataTemplates>
                    <DataTemplate x:DataType="vm:BackupLocationRow">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NameInParens}" Foreground="{StaticResource InkBright}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowName}"/>
                        <Button Classes="linky" Padding="4,0" Background="Transparent" Content="✎" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"
                                VerticalAlignment="Center" Margin="4,0,6,0" ToolTip.Tip="{Binding RenameTip}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.RequestRenameLocationCommand}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>

                <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                  <Border Grid.Column="0" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>
                  <TextBlock Grid.Column="1" Text="{Binding PrimaryWaitingText}" IsVisible="{Binding PrimaryWaitingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="White" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" Margin="10,0,4,0"
                             MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Grid>
            </Border>
        <Panel Grid.Row="1">
          <ContentControl IsVisible="{Binding HasLocation}" Content="{Binding PrimaryLocation}"/>

          <StackPanel IsVisible="{Binding !HasLocation}" Margin="14,12" VerticalAlignment="Top">
            <Button x:Name="GuideAddFolder" Classes="linky" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowLocationPickerCommand}"
                    ToolTip.Tip="Pick the folder your backups live in. Your account and library live here too.">
              <Panel>
                <Rectangle RadiusX="8" RadiusY="8" Stroke="{StaticResource StrokeAmberSoft}" StrokeThickness="1"
                           StrokeDashArray="4,3" Fill="Transparent"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,15" VerticalAlignment="Center">
                  <Border Width="26" Height="26" CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource AccentAmber}">
                    <TextBlock Text="+" Foreground="{StaticResource SurfaceBg}" FontSize="{StaticResource FontRow}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Add Primary Storage"
                             Foreground="{StaticResource AccentAmber}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Panel>
            </Button>
          </StackPanel>
        </Panel>
          </Grid>
        </Border>
        <Border x:Name="GuideSecondaryFolder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="scard" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" VerticalAlignment="Stretch"
                Classes.problem="{Binding SecondaryIsProblem}"
                Classes.disconnected="{Binding SecondaryIsDisconnected}"
                Classes.reattached="{Binding SecondaryJustReattached}">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="shead">

              <Grid ColumnDefinitions="Auto,Auto,*">
                <TextBlock Grid.Column="0" Classes="sgh" Text="SECONDARY STORAGE"/>

                <ContentControl Grid.Column="1" Content="{Binding SecondaryLocation}" VerticalAlignment="Center">
                  <ContentControl.DataTemplates>
                    <DataTemplate x:DataType="vm:BackupLocationRow">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NameInParens}" Foreground="{StaticResource InkBright}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowName}"/>
                        <Button Classes="linky" Padding="4,0" Background="Transparent" Content="✎" Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"
                                VerticalAlignment="Center" Margin="4,0,6,0" ToolTip.Tip="{Binding RenameTip}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Storage.RequestRenameLocationCommand}" CommandParameter="{Binding}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>

                <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                  <Border Grid.Column="0" Classes="shrule" Background="{StaticResource NeutralRuleFade}"/>
                  <TextBlock Grid.Column="1" Text="{Binding SecondaryWaitingText}" IsVisible="{Binding SecondaryWaitingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="White" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" Margin="10,0,4,0"
                             MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Grid>
            </Border>
        <Panel Grid.Row="1">
          <ContentControl IsVisible="{Binding HasSecondary}" Content="{Binding SecondaryLocation}"/>

          <StackPanel IsVisible="{Binding !HasSecondary}" Margin="14,12" VerticalAlignment="Top">
            <Button Classes="linky" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" Command="{Binding AddLocationCommand}" IsEnabled="{Binding CanAddSecondary}"
                    ToolTip.Tip="Pick a folder to use as secondary storage.">
              <Panel>
                <Rectangle RadiusX="8" RadiusY="8" Stroke="{StaticResource StrokeAmberSoft}" StrokeThickness="1"
                           StrokeDashArray="4,3" Fill="Transparent"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,15" VerticalAlignment="Center">
                  <Border Width="26" Height="26" CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource AccentAmber}">
                    <TextBlock Text="+" Foreground="{StaticResource SurfaceBg}" FontSize="{StaticResource FontRow}" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Add Secondary Storage"
                             Foreground="{StaticResource AccentAmber}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Panel>
            </Button>

            <TextBlock Text="Secondary storage can mirror your backup, hold the overflow, or keep your cloud saves."
                       Foreground="{StaticResource InkMuted}" FontSize="{StaticResource FontCaption}"
                       TextWrapping="Wrap" Margin="2,10,2,0"/>
          </StackPanel>
        </Panel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource FlatEdge}" BorderThickness="1,1,1,0" ZIndex="-1"/>
        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6" Margin="16,16,10,4">
          <Grid ColumnDefinitions="*,Auto">

            <TextBlock Grid.Column="0" Text="NO PRIMARY STORAGE" Foreground="{StaticResource InkMuted}"
                       FontSize="{StaticResource FontEyebrow}" FontWeight="SemiBold" LetterSpacing="0.6" VerticalAlignment="Center"
                       IsVisible="{Binding !HasLocation}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto" Margin="-8,0,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">

              <Button Classes="sortpill view" IsEnabled="{Binding PrimaryGrid.HasFiles}"
                      Command="{Binding PrimaryGrid.ToggleExpandAllCommand}"
                      ToolTip.Tip="{Binding PrimaryGrid.ExpandAllTip}">

                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Width="10" Height="11" VerticalAlignment="Center" Stretch="None"
                        Stroke="{StaticResource InkDim}" StrokeThickness="1.4"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        IsVisible="{Binding !PrimaryGrid.AllExpanded}"
                        Data="M 1,1.5 L 5,5.5 L 9,1.5 M 1,5.5 L 5,9.5 L 9,5.5"/>
                  <Path Width="10" Height="11" VerticalAlignment="Center" Stretch="None"
                        Stroke="{StaticResource InkDim}" StrokeThickness="1.4"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        IsVisible="{Binding PrimaryGrid.AllExpanded}"
                        Data="M 1,5.5 L 5,1.5 L 9,5.5 M 1,9.5 L 5,5.5 L 9,9.5"/>
                  <TextBlock FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"
                             Text="{Binding PrimaryGrid.ExpandAllLabel}"/>
                </StackPanel>
              </Button>
              <Border Width="1" Height="15" Background="{StaticResource StrokeSubtle}" Margin="4,0" VerticalAlignment="Center"/>

              <Button Classes="sortpill view" IsEnabled="{Binding PrimaryGrid.HasFiles}" ToolTip.Tip="Sort games. Pick the same key again to flip the direction.">
                <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="Sort: " Foreground="{StaticResource InkDim}"/><Run Text="{Binding PrimaryGrid.SortLabel}"/></TextBlock>
                <Button.Flyout><MenuFlyout>
                  <MenuItem Header="{Binding PrimaryGrid.SortMenuName}"  Command="{Binding PrimaryGrid.SortCommand}" CommandParameter="Name"/>
                  <MenuItem Header="{Binding PrimaryGrid.SortMenuSize}"  Command="{Binding PrimaryGrid.SortCommand}" CommandParameter="Size"/>
                </MenuFlyout></Button.Flyout>
              </Button>

              <Button Classes="sortpill view" IsEnabled="{Binding PrimaryGrid.HasTypeChoices}"
                      ToolTip.Tip="Choose which file types this grid shows">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{StaticResource InkDim}" Text="Show: "/>
                  <TextBlock FontSize="{StaticResource FontCaption}" Text="{Binding PrimaryGrid.TypeFilterLabel}"/>
                  <TextBlock FontSize="{StaticResource FontEyebrow}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{StaticResource InkDim}" Text="&#9662;"/>
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="9" MaxWidth="380">
                      <TextBlock Text="Show file types" Foreground="{StaticResource White}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"/>
                      <TextBlock Text="Only picked types are listed here, and only listed files can be moved. Changing this clears the selection."
                                 Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding PrimaryGrid.TypeOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FilterChip">
                            <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,12,4" MinWidth="0">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center" Background="{Binding Swatch}"/>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}"/>
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="sortpill" HorizontalAlignment="Left" Command="{Binding PrimaryGrid.ShowAllTypesCommand}"
                              IsEnabled="{Binding PrimaryGrid.TypeFilterActive}">
                        <TextBlock Text="Show all"/>
                      </Button>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

              <Grid ColumnDefinitions="*,Auto,*" Margin="0,-15,0,0">
                <Border Grid.Column="0" Height="1" Background="{StaticResource StrokeSubtle}" Margin="2,0,6,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Classes="movetag" Text="MOVE FILES" Margin="0,0,-0.6,0"/>
                <Border Grid.Column="2" Height="1" Background="{StaticResource StrokeSubtle}" Margin="6,0,2,0" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="sortpill act" IsEnabled="{Binding CanMoveAllToSecondary}" Command="{Binding MoveAllToSecondaryCommand}"
                        ToolTip.Tip="Move everything to Secondary">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="mlbl" Text="All"/><TextBlock Classes="marw" Text="&#8594;"/></StackPanel>
                </Button>
                <Button Classes="sortpill act" IsEnabled="{Binding CanMoveSelToSecondary}" Command="{Binding MoveSelToSecondaryCommand}"
                        ToolTip.Tip="Move selected file(s) to Secondary">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="mlbl" Text="Selected"/><TextBlock Classes="marw" Text="&#8594;"/></StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>

        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource FlatEdge}" BorderThickness="1,1,1,0" ZIndex="-1"/>
        <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6" Margin="10,16,16,4">
          <Grid ColumnDefinitions="Auto,*">

          </Grid>

          <Grid ColumnDefinitions="Auto,*" Margin="-8,0,0,0" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasAnyBackedUp}">
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">

              <Button Classes="sortpill view" IsEnabled="{Binding SecondaryGrid.HasFiles}"
                      Command="{Binding SecondaryGrid.ToggleExpandAllCommand}"
                      ToolTip.Tip="{Binding SecondaryGrid.ExpandAllTip}">

                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Width="10" Height="11" VerticalAlignment="Center" Stretch="None"
                        Stroke="{StaticResource InkDim}" StrokeThickness="1.4"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        IsVisible="{Binding !SecondaryGrid.AllExpanded}"
                        Data="M 1,1.5 L 5,5.5 L 9,1.5 M 1,5.5 L 5,9.5 L 9,5.5"/>
                  <Path Width="10" Height="11" VerticalAlignment="Center" Stretch="None"
                        Stroke="{StaticResource InkDim}" StrokeThickness="1.4"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        IsVisible="{Binding SecondaryGrid.AllExpanded}"
                        Data="M 1,5.5 L 5,1.5 L 9,5.5 M 1,9.5 L 5,5.5 L 9,9.5"/>
                  <TextBlock FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"
                             Text="{Binding SecondaryGrid.ExpandAllLabel}"/>
                </StackPanel>
              </Button>
              <Border Width="1" Height="15" Background="{StaticResource StrokeSubtle}" Margin="4,0" VerticalAlignment="Center"/>

              <Button Classes="sortpill view" IsEnabled="{Binding SecondaryGrid.HasFiles}" ToolTip.Tip="Sort games. Pick the same key again to flip the direction.">
                <TextBlock FontSize="{StaticResource FontCaption}"><Run Text="Sort: " Foreground="{StaticResource InkDim}"/><Run Text="{Binding SecondaryGrid.SortLabel}"/></TextBlock>
                <Button.Flyout><MenuFlyout>
                  <MenuItem Header="{Binding SecondaryGrid.SortMenuName}"  Command="{Binding SecondaryGrid.SortCommand}" CommandParameter="Name"/>
                  <MenuItem Header="{Binding SecondaryGrid.SortMenuSize}"  Command="{Binding SecondaryGrid.SortCommand}" CommandParameter="Size"/>
                </MenuFlyout></Button.Flyout>
              </Button>

              <Button Classes="sortpill view" IsEnabled="{Binding SecondaryGrid.HasTypeChoices}"
                      ToolTip.Tip="Choose which file types this grid shows">
                <StackPanel Orientation="Horizontal" Spacing="0">
                  <TextBlock FontSize="{StaticResource FontCaption}" Foreground="{StaticResource InkDim}" Text="Show: "/>
                  <TextBlock FontSize="{StaticResource FontCaption}" Text="{Binding SecondaryGrid.TypeFilterLabel}"/>
                  <TextBlock FontSize="{StaticResource FontEyebrow}" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{StaticResource InkDim}" Text="&#9662;"/>
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Spacing="9" MaxWidth="380">
                      <TextBlock Text="Show file types" Foreground="{StaticResource White}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"/>
                      <TextBlock Text="Only picked types are listed here, and only listed files can be moved. Changing this clears the selection."
                                 Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"/>
                      <ItemsControl ItemsSource="{Binding SecondaryGrid.TypeOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FilterChip">
                            <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,12,4" MinWidth="0">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center" Background="{Binding Swatch}"/>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource InkPrimary}" FontSize="{StaticResource FontCaption}"/>
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="sortpill" HorizontalAlignment="Left" Command="{Binding SecondaryGrid.ShowAllTypesCommand}"
                              IsEnabled="{Binding SecondaryGrid.TypeFilterActive}">
                        <TextBlock Text="Show all"/>
                      </Button>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="2">
              <Grid ColumnDefinitions="*,Auto,*" Margin="0,-15,0,0">
                <Border Grid.Column="0" Height="1" Background="{StaticResource StrokeSubtle}" Margin="2,0,6,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Classes="movetag" Text="MOVE FILES" Margin="0,0,-0.6,0"/>
                <Border Grid.Column="2" Height="1" Background="{StaticResource StrokeSubtle}" Margin="6,0,2,0" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="sortpill act" IsEnabled="{Binding CanMoveSelToPrimary}" Command="{Binding MoveSelToPrimaryCommand}"
                        ToolTip.Tip="Move selected file(s) to Primary">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="marw" Text="&#8592;"/><TextBlock Classes="mlbl" Text="Selected"/></StackPanel>
                </Button>
                <Button Classes="sortpill act" IsEnabled="{Binding CanMoveAllToPrimary}" Command="{Binding MoveAllToPrimaryCommand}"
                        ToolTip.Tip="Move everything to Primary">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="marw" Text="&#8592;"/><TextBlock Classes="mlbl" Text="All"/></StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>

        <Border Grid.Row="3" Grid.Column="0" Margin="1,0,1,10" Background="Transparent" BorderThickness="0"
                CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True">
          <Panel>
            <DockPanel IsVisible="{Binding HasLocation}">
              <TextBlock DockPanel.Dock="Top" Text="Nothing backed up here yet." IsVisible="{Binding PrimaryGrid.IsEmpty}"
                         Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" Margin="12,16" HorizontalAlignment="Center"/>

              <ItemsControl x:Name="PrimaryList" ItemsSource="{Binding PrimaryGrid.GroupedRows}">
                <ItemsControl.Template>
                  <ControlTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DockPanel>

            <TextBlock IsVisible="{Binding !HasLocation}" Text="No primary storage." VerticalAlignment="Top"
                       Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" Margin="12,16" HorizontalAlignment="Center"/>
          </Panel>
        </Border>

        <Border Grid.Row="3" Grid.Column="2" Margin="1,0,1,10" Background="Transparent" BorderThickness="0"
                CornerRadius="{StaticResource RadiusCard}" ClipToBounds="True">
          <Panel>
            <DockPanel IsVisible="{Binding HasSecondary}">
              <TextBlock DockPanel.Dock="Top" Text="Nothing backed up here yet." IsVisible="{Binding SecondaryGrid.IsEmpty}"
                         Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" Margin="12,16" HorizontalAlignment="Center"/>

              <ItemsControl x:Name="SecondaryList" ItemsSource="{Binding SecondaryGrid.GroupedRows}">
                <ItemsControl.Template>
                  <ControlTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DockPanel>

            <TextBlock IsVisible="{Binding !HasSecondary}" Text="No secondary storage." VerticalAlignment="Top"
                       Foreground="{StaticResource InkDim}" FontSize="{StaticResource FontCaption}" Margin="12,16" HorizontalAlignment="Center"/>
          </Panel>
        </Border>

      </Grid>
  </DockPanel>
  </Grid>
  </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
