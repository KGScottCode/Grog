<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AccentAmberColor">#D8A040</Color>
    <Color x:Key="AccentAmberDeepColor">#D09820</Color>
    <Color x:Key="AccentAmberHoverColor">#E0B058</Color>
    <Color x:Key="AccentOrangeColor">#D87028</Color>
    <Color x:Key="ErrorRedColor">#C86060</Color>

    <Color x:Key="WarnOrangeColor">#E08838</Color>
    <Color x:Key="SurfaceWarnDark2Color">#2A231D</Color>

    <Color x:Key="SurfaceOkDark2Color">#18271D</Color>

    <Color x:Key="TypeVideosColor">#A090C8</Color>
    <Color x:Key="ErrorRedBrightColor">#F85048</Color>
    <Color x:Key="InkBrightColor">#C6CBD0</Color>
    <Color x:Key="InkDimColor">#9AA1A8</Color>
    <Color x:Key="InkFaintColor">#8A9096</Color>
    <Color x:Key="InkMutedColor">#6E747A</Color>
    <Color x:Key="InkMutedDimColor">#5C6268</Color>
    <Color x:Key="InkPrimaryColor">#E8E0D8</Color>
    <Color x:Key="ScrimBgColor">#D414181D</Color>
    <Color x:Key="ScrimBgStrongColor">#EE14181D</Color>
    <Color x:Key="ScrimSunkenColor">#E60F1216</Color>
    <Color x:Key="ScrimSunkenSoftColor">#CC0F1318</Color>
    <Color x:Key="StrokeAltColor">#33404E</Color>
    <Color x:Key="StrokeStrongColor">#3D4854</Color>
    <Color x:Key="StrokeStrongerColor">#4A525C</Color>
    <Color x:Key="StrokeStrongestColor">#4E5763</Color>
    <Color x:Key="StrokeSubtleColor">#3A424D</Color>
    <Color x:Key="SuccessGreenColor">#70B070</Color>
    <Color x:Key="SuccessGreenVividColor">#40B850</Color>
    <Color x:Key="SurfaceAmberDarkColor">#241F17</Color>
    <Color x:Key="SurfaceAmberDark2Color">#2E2A1C</Color>
    <Color x:Key="SurfaceAmberDark3Color">#2A2419</Color>
    <Color x:Key="SurfaceAmberDark4Color">#3A2E14</Color>

    <Color x:Key="SurfaceAmberSelectColor">#211A0F</Color>

    <Color x:Key="AccentAmberSoftColor">#C09850</Color>
    <Color x:Key="SurfaceAmberSoftColor">#24D8A040</Color>
    <Color x:Key="StrokeAmberSoftColor">#52D8A040</Color>

    <Color x:Key="SurfaceErrorSoftColor">#24C86060</Color>
    <Color x:Key="StrokeErrorSoftColor">#52C86060</Color>
    <Color x:Key="SurfaceBgColor">#14181D</Color>
    <Color x:Key="SurfaceBgAltColor">#141A20</Color>
    <Color x:Key="SurfaceErrorDarkColor">#2A1F1C</Color>
    <Color x:Key="SurfaceErrorDark2Color">#3A1E1E</Color>
    <Color x:Key="SurfaceGreenDarkColor">#14251A</Color>
    <Color x:Key="SurfaceNeutralDarkColor">#1A1A1A</Color>
    <Color x:Key="SurfacePanelColor">#1B2027</Color>

    <Color x:Key="SurfaceCardColor">#181D23</Color>

    <Color x:Key="SurfaceSectionColor">#1C222A</Color>
    <Color x:Key="SurfacePanelAltColor">#191F26</Color>
    <Color x:Key="SurfaceRaisedColor">#20262E</Color>
    <Color x:Key="SurfaceRaisedAltColor">#1E242B</Color>
    <Color x:Key="SurfaceRaisedAlt2Color">#232A32</Color>
    <Color x:Key="SurfaceRaisedAlt3Color">#262D36</Color>
    <Color x:Key="SurfaceStrokeColor">#2B333D</Color>
    <Color x:Key="SurfaceSunkenColor">#0F1318</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="AccentAmber" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentAmberDeep" Color="{StaticResource AccentAmberDeepColor}" />
    <SolidColorBrush x:Key="AccentAmberHover" Color="{StaticResource AccentAmberHoverColor}" />
    <SolidColorBrush x:Key="AccentOrange" Color="{StaticResource AccentOrangeColor}" />
    <SolidColorBrush x:Key="AccentAmberSoft" Color="{StaticResource AccentAmberSoftColor}" />
    <SolidColorBrush x:Key="SurfaceAmberSoft" Color="{StaticResource SurfaceAmberSoftColor}" />
    <SolidColorBrush x:Key="StrokeAmberSoft" Color="{StaticResource StrokeAmberSoftColor}" />
    <SolidColorBrush x:Key="SurfaceErrorSoft" Color="{StaticResource SurfaceErrorSoftColor}" />
    <SolidColorBrush x:Key="StrokeErrorSoft" Color="{StaticResource StrokeErrorSoftColor}" />
    <SolidColorBrush x:Key="ErrorRed" Color="{StaticResource ErrorRedColor}" />
    <SolidColorBrush x:Key="WarnOrange" Color="{StaticResource WarnOrangeColor}" />
    <SolidColorBrush x:Key="ErrorRedBright" Color="{StaticResource ErrorRedBrightColor}" />
    <SolidColorBrush x:Key="InkBright" Color="{StaticResource InkBrightColor}" />
    <SolidColorBrush x:Key="InkDim" Color="{StaticResource InkDimColor}" />
    <SolidColorBrush x:Key="InkFaint" Color="{StaticResource InkFaintColor}" />
    <SolidColorBrush x:Key="InkMuted" Color="{StaticResource InkMutedColor}" />
    <SolidColorBrush x:Key="InkMutedDim" Color="{StaticResource InkMutedDimColor}" />
    <SolidColorBrush x:Key="InkPrimary" Color="{StaticResource InkPrimaryColor}" />
    <SolidColorBrush x:Key="ScrimBg" Color="{StaticResource ScrimBgColor}" />
    <SolidColorBrush x:Key="ScrimBgStrong" Color="{StaticResource ScrimBgStrongColor}" />
    <SolidColorBrush x:Key="ScrimSunken" Color="{StaticResource ScrimSunkenColor}" />
    <SolidColorBrush x:Key="ScrimSunkenSoft" Color="{StaticResource ScrimSunkenSoftColor}" />
    <SolidColorBrush x:Key="StrokeAlt" Color="{StaticResource StrokeAltColor}" />
    <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="StrokeStronger" Color="{StaticResource StrokeStrongerColor}" />
    <SolidColorBrush x:Key="StrokeStrongest" Color="{StaticResource StrokeStrongestColor}" />
    <SolidColorBrush x:Key="StrokeSubtle" Color="{StaticResource StrokeSubtleColor}" />
    <SolidColorBrush x:Key="SuccessGreen" Color="{StaticResource SuccessGreenColor}" />
    <SolidColorBrush x:Key="SuccessGreenVivid" Color="{StaticResource SuccessGreenVividColor}" />
    <SolidColorBrush x:Key="SurfaceAmberDark" Color="{StaticResource SurfaceAmberDarkColor}" />
    <SolidColorBrush x:Key="SurfaceAmberDark2" Color="{StaticResource SurfaceAmberDark2Color}" />
    <SolidColorBrush x:Key="SurfaceAmberDark3" Color="{StaticResource SurfaceAmberDark3Color}" />
    <SolidColorBrush x:Key="SurfaceAmberDark4" Color="{StaticResource SurfaceAmberDark4Color}" />
    <SolidColorBrush x:Key="SurfaceAmberSelect" Color="{StaticResource SurfaceAmberSelectColor}" />
    <SolidColorBrush x:Key="SurfaceBg" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceBgAlt" Color="{StaticResource SurfaceBgAltColor}" />
    <SolidColorBrush x:Key="SurfaceErrorDark" Color="{StaticResource SurfaceErrorDarkColor}" />
    <SolidColorBrush x:Key="SurfaceErrorDark2" Color="{StaticResource SurfaceErrorDark2Color}" />
    <SolidColorBrush x:Key="SurfaceWarnDark2" Color="{StaticResource SurfaceWarnDark2Color}" />
    <SolidColorBrush x:Key="SurfaceOkDark2" Color="{StaticResource SurfaceOkDark2Color}" />
    <SolidColorBrush x:Key="TypeVideos" Color="{StaticResource TypeVideosColor}" />
    <SolidColorBrush x:Key="SurfaceGreenDark" Color="{StaticResource SurfaceGreenDarkColor}" />
    <SolidColorBrush x:Key="SurfaceNeutralDark" Color="{StaticResource SurfaceNeutralDarkColor}" />
    <SolidColorBrush x:Key="SurfacePanel" Color="{StaticResource SurfacePanelColor}" />
    <SolidColorBrush x:Key="SurfaceCard" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="SurfaceSection" Color="{StaticResource SurfaceSectionColor}" />
    <SolidColorBrush x:Key="SurfacePanelAlt" Color="{StaticResource SurfacePanelAltColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedAlt" Color="{StaticResource SurfaceRaisedAltColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedAlt2" Color="{StaticResource SurfaceRaisedAlt2Color}" />
    <SolidColorBrush x:Key="SurfaceRaisedAlt3" Color="{StaticResource SurfaceRaisedAlt3Color}" />
    <SolidColorBrush x:Key="SurfaceStroke" Color="{StaticResource SurfaceStrokeColor}" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="{StaticResource SurfaceSunkenColor}" />
    <SolidColorBrush x:Key="White" Color="{StaticResource WhiteColor}" />

    <SolidColorBrush x:Key="FlatEdge"    Color="#FFFFFF" Opacity="0.09" />
    <SolidColorBrush x:Key="FlatRowLine" Color="#FFFFFF" Opacity="0.05" />

    <SolidColorBrush x:Key="RowHairline"      Color="#FFFFFF" Opacity="0.06" />
    <SolidColorBrush x:Key="RowHairlineStrong" Color="#FFFFFF" Opacity="0.15" />
    <SolidColorBrush x:Key="RowHoverFill"     Color="#FFFFFF" Opacity="0.13" />
    <SolidColorBrush x:Key="RowSelectFill"    Color="#FFFFFF" Opacity="0.24" />

    <SolidColorBrush x:Key="ThemeSwatchDefault"       Color="#D9A441" />
    <SolidColorBrush x:Key="ThemeSwatchOdeToGog"      Color="#A874FF" />
    <SolidColorBrush x:Key="ThemeSwatchTavernFill"    Color="#0B0A08" />
    <SolidColorBrush x:Key="ThemeSwatchTavernStroke"  Color="#E2A63B" />

    <SolidColorBrush x:Key="StrokeDangerInput" Color="#5A2F2D" />
    <SolidColorBrush x:Key="StrokeWarnInput"   Color="#5A4326" />

    <SolidColorBrush x:Key="BrandTileInk"      Color="#1A1408" />
    <SolidColorBrush x:Key="WinCloseHover"     Color="#C0342E" />
    <SolidColorBrush x:Key="NavActiveTint" Color="{StaticResource AccentAmberColor}" Opacity="0.10" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentAmberHoverColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentAmberDeepColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{StaticResource StrokeAmberSoftColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentAmberHoverColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource AccentAmberDeepColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="{StaticResource StrokeAmberSoftColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource SurfaceBgColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource SurfaceBgColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="{StaticResource SurfaceBgColor}"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="{StaticResource InkMutedDimColor}"/>

    <LinearGradientBrush x:Key="AmberRuleFade" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#60D9A441" Offset="0"/>
        <GradientStop Color="#00D9A441" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AmberEdgeFade" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#60D9A441" Offset="0"/>
        <GradientStop Color="#00D9A441" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RowRuleFade" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#44FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RowRuleFadeIn" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#44FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessRuleFade" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#9959C46B" Offset="0"/>
        <GradientStop Color="#0059C46B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessRuleFadeIn" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#0059C46B" Offset="0"/>
        <GradientStop Color="#9959C46B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeutralRuleFade" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#2BFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeutralRuleFadeIn" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#2BFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SectionFadeOut" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#1C222A" Offset="0"/>
        <GradientStop Color="#001C222A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SectionFadeLong" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#1C222A" Offset="0"/>
        <GradientStop Color="#001C222A" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardTopHighlight" Color="#FFFFFF" Opacity="0.055" />

    <LinearGradientBrush x:Key="SpeedTraceFill" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#60D9A441" Offset="0"/>
        <GradientStop Color="#1AD9A441" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ColumnDividerBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#26FFFFFF" Offset="0.06"/>
        <GradientStop Color="#26FFFFFF" Offset="0.94"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CanvasGlow" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#161B21" Offset="0"/>
        <GradientStop Color="#161B21" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RailSurface" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#171C22" Offset="0"/>
        <GradientStop Color="#12161B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardSurface" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#191E25" Offset="0"/>
        <GradientStop Color="#191E25" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="PlotRecess" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="75%" RadiusY="95%">
        <GradientStop Color="#12171C" Offset="0"/>
        <GradientStop Color="#12171C" Offset="0.55"/>
        <GradientStop Color="#12171C" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="RailEdge" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.1"/>
        <GradientStop Color="#12FFFFFF" Offset="0.9"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="RailBrandGlow" Center="0%,0%" GradientOrigin="0%,0%" RadiusX="42%" RadiusY="115%">
        <GradientStop Color="#60D9A441" Offset="0"/>
        <GradientStop Color="#10D9A441" Offset="0.30"/>
        <GradientStop Color="#00D9A441" Offset="0.70"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RailFootShadow" StartPoint="50%,100%" EndPoint="50%,0%">
        <GradientStop Color="#80000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandTileBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource AccentAmberHoverColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentAmberDeepColor}" Offset="1"/>
    </LinearGradientBrush>

    <x:Double x:Key="FontTitle">22</x:Double>
    <x:Double x:Key="FontSection">17.5</x:Double>
    <x:Double x:Key="FontRow">17</x:Double>
    <x:Double x:Key="FontBody">15.5</x:Double>
    <x:Double x:Key="FontCaption">14</x:Double>
    <x:Double x:Key="FontEyebrow">12</x:Double>

    <x:Double x:Key="TrackSection">2.4</x:Double>

    <CornerRadius x:Key="RadiusChip">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
</ResourceDictionary>
