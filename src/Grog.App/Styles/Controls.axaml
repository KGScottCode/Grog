<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="ProgressBar">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>

        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ProgressBar.slim">       <Setter Property="Height" Value="3"/>  <Setter Property="CornerRadius" Value="2"/></Style>
    <Style Selector="ProgressBar.row">        <Setter Property="Height" Value="6"/>  <Setter Property="CornerRadius" Value="3"/></Style>
    <Style Selector="ProgressBar.prominent">  <Setter Property="Height" Value="12"/> <Setter Property="CornerRadius" Value="6"/></Style>
</Styles>
