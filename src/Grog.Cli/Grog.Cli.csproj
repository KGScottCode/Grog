<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The binary must BE the name the product documents. The help output and docs/AUTOMATION.md both
         tell people to type 'grogcli'; without this they get Grog.Cli.exe and the docs are wrong. -->
    <AssemblyName>grogcli</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Grog.Core\Grog.Core.csproj" />
  </ItemGroup>
</Project>
