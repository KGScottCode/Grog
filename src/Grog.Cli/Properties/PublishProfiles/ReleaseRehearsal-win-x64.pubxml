<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors release.yml "Publish CLI" for win-x64. Right-click Grog.Cli > Publish > this profile > Publish.
     Then run publish\grogcli.exe --version from Explorer via a shortcut, or open Properties > Details on the exe: File version 0.1.0. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
